---
import BaseLayout from './BaseLayout.astro';
import { defaultLanguage, type Language } from '../i18n/config';

interface Props {
  title?: string;
  lang?: Language;
}

const { title = 'История исследования', lang = defaultLanguage } = Astro.props;
---
<BaseLayout title={title} lang={lang} hasEnglishAlternate={false}>
  <slot />
</BaseLayout>
