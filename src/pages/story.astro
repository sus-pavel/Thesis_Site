---
import StoryLayout from '../layouts/StoryLayout.astro';
import ScrollStory from '../components/scrollytelling/ScrollStory.astro';
import StoryRu from '../content/ru/story.mdx';
import StoryEn from '../content/en/story.mdx';
import { storyVisuals } from '../data/visuals';
---
<StoryLayout>
  <section class="story-hero">
    <div class="container">
      <p class="eyebrow">Research story · {storyVisuals.length} визуальных сцен</p>
      <h1>От сигнала нагрузки<br/><span>к управляющему воздействию</span></h1>
      <div class="intro-grid">
        <p>Последовательная история о том, как временной ряд электропотребления становится основой адресного управления спросом в автономном ЭТК.</p>
        <a href="#story-start">Прокрутите, чтобы начать <b>↓</b></a>
      </div>
    </div>
  </section>
  <div id="story-start">
    <div class="language-content" data-lang="ru"><ScrollStory visuals={storyVisuals}><StoryRu /></ScrollStory></div>
    <div class="language-content" data-lang="en"><ScrollStory visuals={storyVisuals.slice(0, 1)}><StoryEn /></ScrollStory></div>
  </div>
</StoryLayout>
<style>
  .story-hero { min-height: 78vh; display: flex; align-items: center; padding: 85px 0; border-bottom: 1px solid var(--line); background: radial-gradient(circle at 80% 45%, rgba(24,86,216,.12), transparent 30%); }
  h1 { margin: 0; font-size: clamp(3rem, 7vw, 7.5rem); line-height: .92; letter-spacing: -.065em; }
  h1 span { color: var(--blue); }
  .intro-grid { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: end; margin-top: 44px; }
  .intro-grid p { max-width: 680px; margin: 0; color: #536176; font-family: Georgia, serif; font-size: 1.18rem; }
  .intro-grid a { color: var(--blue); font-size: .75rem; font-weight: 800; }
  .intro-grid b { padding-left: 8px; }
  @media (max-width: 700px) { .intro-grid { grid-template-columns: 1fr; } }
</style>
