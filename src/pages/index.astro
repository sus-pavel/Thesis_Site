---
/**
 * Главная страница диссертационного сайта.
 * Здесь находятся hero-блок, краткая аннотация, положения и ключевые показатели.
 * Основной текст аннотации редактируется в src/content/ru/home.mdx.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import KPIBlock from '../components/visuals/KPIBlock.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import HomeRu from '../content/ru/home.mdx';
import { siteConfig } from '../data/siteConfig';
import { localizedHref, withBase } from '../i18n/config';

// Сведения о защите редактируются вручную здесь.
const defence = {
  venue: 'Санкт-Петербургский горный университет императрицы Екатерины II',
  room: 'аудитория 1171',
};

const sections = [
  { number: '01', href: '/architecture', title: 'Архитектура решения', text: 'Две интерактивные схемы: от аудита потенциала до адресного управления.' },
  { number: '02', href: '/publications', title: 'Публикации', text: 'Scopus, ВАК, конференции и свидетельство на программу для ЭВМ.' },
  { number: '03', href: '/downloads', title: 'Материалы', text: 'Диссертация, автореферат, презентация и данные.' },
];

const hrefFor = (href: string) => localizedHref(href);
---

<BaseLayout>
  <main id="main-content" tabindex="-1">
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <div class="hero-meta">
            <span class="pill">
              <i class="dot"></i>
              Диссертация на соискание учёной степени кандидата технических наук
            </span>
            <span class="hero-topline">
              {siteConfig.specialty}
              <i aria-hidden="true">·</i>
              <strong>Защита 29.09.2026 · 13:00</strong>
            </span>
          </div>

          <h1 class="display">
            Управление спросом <span class="accent">на электроэнергию</span> автономных электротехнических комплексов
          </h1>

          <p class="subtitle">путём идентификации паттернов и классификации нагрузок</p>

          <div class="hero-utility">
            <div class="author-card">
              <span>Автор</span>
              <strong>{siteConfig.author}</strong>
              <small>Санкт-Петербургский горный университет императрицы Екатерины II</small>
            </div>

            <dl class="defence-brief" aria-label="Сведения о защите">
              <div>
                <dt>Защита</dt>
                <dd>
                  <time datetime="2026-09-29T13:00:00+03:00">29 сентября 2026</time>
                  <span>13:00</span>
                </dd>
              </div>
              <div>
                <dt>Место</dt>
                <dd>{defence.venue}<span>{defence.room}</span></dd>
              </div>
            </dl>

            <div class="actions">
              <a class="button button--primary" href={withBase('/downloads/autoreferat.pdf')} download>
                <span class="desktop-label">Скачать автореферат</span>
                <span class="mobile-label">Автореферат · PDF</span>
              </a>
              <a class="button" href={hrefFor('/architecture')}>
                <span class="desktop-label">Открыть архитектуру</span>
                <span class="mobile-label">Архитектура</span>
                <span aria-hidden="true">↗</span>
              </a>
              <a class="text-link" href={withBase('/downloads/dissertation.pdf')} download>
                Полный текст диссертации · PDF
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--summary">
      <div class="container summary-grid">
        <div>
          <SectionTitle
            number="00"
            eyebrow="Краткая аннотация"
            title="Структура диссертационного исследования"
          />

          <div class="thesis-scheme" aria-label="Структура диссертации">

            <div class="thesis-box">
              <span>Аудит потенциала внедрения ТУС</span>
            </div>

            <div class="thesis-operator">+</div>

            <div class="thesis-box">

              <span>Расчёт эффектов от внедрения ТУС с учётом классификации электроприёмников</span>
            </div>

            <div class="thesis-operator">=</div>

            <div class="thesis-box thesis-box--main">
              <span>Диссертация</span>
            </div>
            
          </div>
        </div>

        <div>
          <div class="prose"><HomeRu /></div>
        </div>
      </div>
    </section>

    <section class="section positions-section">
      <div class="container">
        <SectionTitle
          number="01"
          eyebrow="Логика исследования"
          title={"Сначала – решение о внедрении.\nЗатем – способ управления"}
        />

        <div class="position-map">
          <article>
            <div class="position-head">
              <span>Положение 1</span>
              <b>Аудит</b>
            </div>

            <h3>Есть ли у объекта потенциал для управления спросом?</h3>

            <p>
              Применение ИПУС (DR PI), рассчитанного на основе паттернов, полученных при помощи предложенного принципа
              кластеризации компонент SSA временного ряда потребления ЭЭ, позволяет получить количественную оценку
              потенциала применения ТУС (DSM) в автономных ЭТК с гибридной генерацией.
            </p>

            <ol>
              <li>Исходные данные: топология ЭТК, параметры элементов энергосистемы</li>
              <li>SSA анализ профилей потребления ЭЭ</li>
              <li>Определение RMS амплитуды и частоты элементарных компонент</li>
              <li>Кластеризация методом k-means в амплитудно-частотном пространстве</li>
              <li>Получение паттернов электропотребления</li>
              <li>Расчёт ИПУС (DR PI) и тепловой карты потенциала применения ТУС (DSM)</li>
            </ol>
          </article>

          <div class="position-arrow" aria-hidden="true">→</div>

          <article>
            <div class="position-head">
              <span>Положение 2</span>
              <b>Применение</b>
            </div>

            <h3>Как управлять нагрузками и какой эффект это даёт?</h3>

            <p>
              Внедрение технологии ТУС (DSM), основанной на разработанной классификации электроприёмников,
              обеспечивает повышение эффективности работы автономного ЭТК с гибридной генерацией.
            </p>

            <div class="paragraph-gap" aria-hidden="true"></div>

            <ol>
              <li>Предлагается новая классификация электроприёмников</li>
              <li>Каждому классу нагрузки соответствует свой способ управления</li>
              <li>Для каждого класса нагрузки определяются оптимизационные параметры</li>
              <li>Оптимизация параметров управления нагрузками методом CC-PSO</li>
              <li>Проведение итерационного моделирования в Matpower</li>
              <li>Расчёт экономического, технологического и экологического эффектов</li>
            </ol>
          </article>
        </div>
      </div>
    </section>

    <section class="section metrics-section">
      <div class="container">
        <SectionTitle
          number="02"
          eyebrow="Результат второго положения"
          title="Эффект подтверждается экономическими, технологическими и экологическими показателями"
        />

        <KPIBlock />

        <p class="data-note">
          <span></span>
          Результаты расчётного примера из диссертации и автореферата. Логика метода и связи между расчётными блоками раскрываются в архитектуре решения.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <SectionTitle number="→" eyebrow="Навигация" title="Три способа прочитать работу" />

        <div class="section-links">
          {sections.map((section) => (
            <a href={hrefFor(section.href)}>
              <span>{section.number}</span>
              <div>
                <h3>{section.title}</h3>
                <p>{section.text}</p>
              </div>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 64px 0 44px;
  }

  .hero-inner {
    display: grid;
    gap: 55px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
    color: #596777;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .hero-topline {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    text-align: right;
  }

  .hero-topline i {
    color: var(--orange);
    font-style: normal;
  }

  .hero-topline strong {
    color: var(--ink);
    font-weight: 850;
  }

  .subtitle {
    max-width: 850px;
    margin: 22px 0 0;
    color: #556276;
    font-family: Georgia, serif;
    font-size: clamp(1.18rem, 2.2vw, 1.65rem);
  }

  .hero-utility {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(340px, 1.15fr) auto;
    gap: clamp(24px, 4vw, 52px);
    align-items: end;
    margin-top: 42px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }

  .author-card {
    display: grid;
    gap: 3px;
  }

  .author-card > span,
  .defence-brief dt {
    color: var(--muted);
    font-size: .66rem;
    font-weight: 850;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .author-card > strong {
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.3;
  }

  .author-card small {
    max-width: 390px;
    color: var(--muted-soft);
    font-size: .74rem;
    line-height: 1.45;
  }

  .defence-brief {
    display: grid;
    grid-template-columns: .78fr 1.22fr;
    gap: 20px;
    margin: 0;
  }

  .defence-brief div {
    min-width: 0;
  }

  .defence-brief dd {
    margin: 5px 0 0;
    color: var(--ink);
    font-size: .82rem;
    font-weight: 760;
    line-height: 1.4;
  }

  .defence-brief dd span {
    display: block;
    color: var(--muted-soft);
    font-size: .72rem;
    font-weight: 650;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 9px;
    max-width: 430px;
  }

  .actions .button {
    min-height: 44px;
    padding-inline: 16px;
  }

  .mobile-label {
    display: none;
  }

  .actions .button:nth-child(2) {
    border-color: var(--line);
    color: var(--ink);
    background: rgba(255, 255, 255, .72);
  }

  .actions .button:nth-child(2):hover {
    border-color: var(--ink);
    color: #ffffff;
    background: var(--ink);
  }

  .text-link {
    margin: 1px 12px 0 auto;
    color: var(--blue-dark);
    font-size: .72rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: rgba(24, 86, 216, .28);
    text-underline-offset: 4px;
  }

  .section--summary {
    background: rgba(255, 255, 255, .62);
    border-block: 1px solid var(--line);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 7vw;
  }

  .summary-grid :global(h2) {
    font-size: 2rem;
  }

  .thesis-scheme {
    margin-top: 28px;
    display: grid;
    gap: 10px;
    max-width: 520px;
  }

  .thesis-box {
    position: relative;
    padding: 18px 20px;
    border: 1px solid rgba(47, 91, 216, .22);
    border-radius: 18px;
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 18px 42px rgba(36, 54, 79, .07);
    color: #2f3b4d;
    font-size: clamp(.92rem, 1.4vw, 1.08rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .thesis-box--main {
    border-color: rgba(47, 91, 216, .34);
    background:
      linear-gradient(135deg, rgba(47, 91, 216, .11), rgba(255, 255, 255, .88));
    color: var(--blue);
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
  }

  .thesis-box span {
    display: block;
  }

  .thesis-operator {
    justify-self: center;
    color: var(--orange);
    font-size: 1.05rem;
    font-weight: 900;
    line-height: 1;
  }

  .positions-section {
    background: rgba(255, 255, 255, .4);
  }

  .position-map {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 22px;
    align-items: stretch;
  }

  .position-map article {
    padding: clamp(24px, 3.5vw, 42px);
    border: 1px solid var(--line);
    border-radius: 22px;
    background: rgba(255, 255, 255, .88);
  }

  .position-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--blue);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .position-head b {
    color: var(--orange-text);
  }

  .position-map h3 {
    margin: 30px 0 14px;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .position-map p {
    color: #536176;
    font-family: Georgia, serif;
  }

  .paragraph-gap {
    height: 48px;
  }

  .position-map ol {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }

  .position-map li {
    counter-increment: stage;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: .78rem;
  }

  .position-map li::before {
    content: "0" counter(stage);
    display: inline-block;
    width: 30px;
    color: var(--blue);
    font-weight: 800;
  }

  .position-arrow {
    align-self: center;
    color: var(--blue);
    font-size: 1.8rem;
  }

  .metrics-section {
    background: #eef3f7;
  }

  .data-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 20px 0 0;
    color: var(--muted-soft);
    font-size: .7rem;
  }

  .data-note span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
    flex: 0 0 auto;
  }

  .section-links {
    border-top: 1px solid var(--line);
  }

  .section-links a {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 28px 4px;
    border-bottom: 1px solid var(--line);
    transition: padding .2s ease, background .2s ease;
  }

  .section-links a:hover {
    padding-inline: 18px;
    background: rgba(255, 255, 255, .72);
  }

  .section-links span {
    color: var(--orange-text);
    font-size: .72rem;
    font-weight: 800;
  }

  .section-links h3 {
    margin: 0;
    font-size: 1.4rem;
  }

  .section-links p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: .82rem;
  }

  .section-links b {
    color: var(--blue);
    font-size: 1.4rem;
  }

  @media (max-width: 800px) {
    .hero {
      min-height: auto;
    }

    .hero-meta {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-topline {
      flex-wrap: wrap;
      justify-content: flex-start;
      text-align: left;
    }

    .hero-utility {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .actions {
      order: -1;
      justify-content: flex-start;
      max-width: none;
    }

    .text-link {
      margin-left: 0;
    }

    .summary-grid {
      grid-template-columns: 1fr;
    }

    .thesis-scheme {
      max-width: none;
    }

    .thesis-box {
      padding: 16px 18px;
      border-radius: 16px;
    }

    .position-map {
      grid-template-columns: 1fr;
    }

    .position-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }

    .paragraph-gap {
      height: 16px;
    }

    .section-links a {
      grid-template-columns: 35px 1fr auto;
      gap: 10px;
    }
  }

  @media (max-width: 550px) {
    .actions .button {
      padding-inline: 13px;
      font-size: .78rem;
    }

    .desktop-label { display: none; }
    .mobile-label { display: inline; }
  }
</style>
