---
import BaseLayout from '../layouts/BaseLayout.astro';
import KPIBlock from '../components/visuals/KPIBlock.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import HomeRu from '../content/ru/home.mdx';
import HomeEn from '../content/en/home.mdx';
import { siteConfig } from '../data/siteConfig';
const sections = [
  { number: '01', href: '/story', title: 'История исследования', text: 'От временного ряда нагрузки до оптимального режима автономного ЭТК.' },
  { number: '02', href: '/statements', title: 'Положения на защиту', text: 'Два положения и связанная с ними доказательная структура.' },
  { number: '03', href: '/publications', title: 'Публикации', text: 'Scopus, ВАК, конференции и программная реализация.' },
  { number: '04', href: '/downloads', title: 'Материалы', text: 'Диссертация, автореферат, презентация, брошюра и данные.' },
];
---
<BaseLayout>
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <div class="hero-meta">
            <span class="pill"><i class="dot"></i> диссертационное исследование</span>
            <span>{siteConfig.specialty}</span>
          </div>
          <h1 class="display">Управление спросом <span class="accent">на электроэнергию</span> автономных электротехнических комплексов</h1>
          <p class="subtitle">путём идентификации паттернов и классификации нагрузок</p>
          <div class="hero-footer">
            <p><strong>{siteConfig.author}</strong><br/>соискатель учёной степени кандидата технических наук</p>
            <div class="actions">
              <a class="button button--primary" href="/story">Начать исследование <span>↓</span></a>
              <a class="button" href="/statements">Положения на защиту</a>
            </div>
          </div>
        </div>
        <div class="signal" aria-hidden="true">
          <div class="signal-label">P(t)</div>
          <svg viewBox="0 0 1000 230" preserveAspectRatio="none">
            <path class="gridline" d="M0 50H1000M0 115H1000M0 180H1000"/>
            <path class="wave-secondary" d="M0 150C80 135 110 170 185 145S290 65 365 122s120 76 190 18 115-78 180-15 140 76 265 8"/>
            <path class="wave" d="M0 165C70 150 120 80 190 127s110 32 160-24 120-54 175 20 105 92 165 10 135-100 180-33 85 78 130 25"/>
          </svg>
          <div class="signal-axis"><span>00:00</span><span>DR PI</span><span>24:00</span></div>
        </div>
      </div>
    </section>

    <section class="section section--summary">
      <div class="container summary-grid">
        <SectionTitle number="00" eyebrow="Краткая аннотация" title="Данные превращаются в управляемую гибкость" />
        <div class="language-content prose" data-lang="ru"><HomeRu /></div>
        <div class="language-content prose" data-lang="en"><HomeEn /></div>
      </div>
    </section>

    <section class="section metrics-section">
      <div class="container">
        <SectionTitle number="04" eyebrow="Ключевые результаты" title="Эффект измеряется в режиме, стоимости и выбросах" />
        <KPIBlock />
        <p class="data-note"><span></span> Показатели демонстрационной версии взяты из технического задания. Исходные расчётные файлы будут подключены позже.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <SectionTitle number="→" eyebrow="Навигация" title="Четыре способа прочитать работу" />
        <div class="section-links">
          {sections.map((section) => (
            <a href={section.href}>
              <span>{section.number}</span>
              <div><h3>{section.title}</h3><p>{section.text}</p></div>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { min-height: calc(100vh - 64px); display: flex; align-items: center; overflow: hidden; padding: 78px 0 50px; }
  .hero-inner { display: grid; gap: 55px; }
  .hero-meta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; color: #768394; font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .subtitle { max-width: 850px; margin: 22px 0 0; color: #556276; font-family: Georgia, serif; font-size: clamp(1.18rem, 2.2vw, 1.65rem); }
  .hero-footer { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-top: 46px; }
  .hero-footer p { margin: 0; color: #657284; font-size: .8rem; }
  .hero-footer strong { color: var(--ink); font-size: .92rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .signal { position: relative; }
  .signal svg { width: 100%; height: clamp(130px, 18vw, 220px); }
  .gridline { fill: none; stroke: #ced9e2; stroke-width: 1; stroke-dasharray: 4 7; }
  .wave-secondary { fill: none; stroke: #a9b8c6; stroke-width: 2; stroke-dasharray: 7 8; }
  .wave { fill: none; stroke: var(--blue); stroke-width: 5; vector-effect: non-scaling-stroke; }
  .signal-label { position: absolute; top: 2px; left: 0; color: var(--orange); font-size: .68rem; font-weight: 800; }
  .signal-axis { display: flex; justify-content: space-between; color: #8996a4; font-family: ui-monospace, monospace; font-size: .62rem; }
  .section--summary { background: rgba(255,255,255,.62); border-block: 1px solid var(--line); }
  .summary-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 7vw; }
  .summary-grid :global(h2) { font-size: 2rem; }
  .metrics-section { background: #eef3f7; }
  .data-note { display: flex; align-items: center; gap: 9px; margin: 20px 0 0; color: #748191; font-size: .7rem; }
  .data-note span { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }
  .section-links { border-top: 1px solid var(--line); }
  .section-links a { display: grid; grid-template-columns: 70px 1fr auto; gap: 28px; align-items: center; padding: 28px 4px; border-bottom: 1px solid var(--line); transition: padding .2s ease, background .2s ease; }
  .section-links a:hover { padding-inline: 18px; background: rgba(255,255,255,.72); }
  .section-links span { color: var(--orange); font-size: .72rem; font-weight: 800; }
  .section-links h3 { margin: 0; font-size: 1.4rem; }
  .section-links p { margin: 4px 0 0; color: var(--muted); font-size: .82rem; }
  .section-links b { color: var(--blue); font-size: 1.4rem; }
  @media (max-width: 800px) {
    .hero { min-height: auto; }
    .hero-meta, .hero-footer { align-items: flex-start; flex-direction: column; }
    .summary-grid { grid-template-columns: 1fr; }
    .section-links a { grid-template-columns: 35px 1fr auto; gap: 10px; }
  }
</style>
