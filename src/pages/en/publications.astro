---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import PublicationProfiles from '../../components/publications/PublicationProfiles.astro';
import PublicationsEn from '../../content/en/publications.mdx';
import publications from '../../../public/data/publications/publications.json';

const typeLabels: Record<string, string> = {
  scopus: 'Scopus',
  vak: 'Journals listed by the Higher Attestation Commission',
  conference: 'Conferences',
  other: 'Other',
  software: 'Software Registrations',
};
const types = Object.keys(typeLabels);
const counts = Object.fromEntries(types.map((type) => [type, publications.filter((item) => item.type === type).length]));
const confirmedAuthorNames: Record<string, string> = {
  'Жуковский Ю. Л.': 'Y. L. Zhukovskiy',
  'Сусликов П. К.': 'P. K. Suslikov',
  'Zhukovskiy Y. L.': 'Y. L. Zhukovskiy',
  'Suslikov P. K.': 'P. K. Suslikov',
  'Rasputin D. L.': 'D. L. Rasputin',
};
const getEnglishAuthors = (authors: string[]) => authors.map((author) => confirmedAuthorNames[author] ?? author);
const formatPages = (pages: string | null) => pages?.replace('-', '–');
const getCitationDetails = (item: (typeof publications)[number]) => [
  item.source,
  item.volume && `Vol. ${item.volume}`,
  item.issue && `No. ${item.issue}`,
  item.pages && `pp. ${formatPages(item.pages)}`,
  item.registrationNumber && (
    item.registrationNumber.startsWith('EDN')
      ? item.registrationNumber
      : `Registration No. ${item.registrationNumber}`
  ),
].filter(Boolean).join(' · ');
---

<BaseLayout
  lang="en"
  title="Publications"
  description="Publications and software registrations supporting the dissertation research propositions."
>
  <PageShell eyebrow="RESEARCH OUTPUTS" title="Publications and Software Registrations">
    <PublicationProfiles slot="hero-aside" lang="en" />
    <div class="stats">
      <div><strong>{String(counts.scopus).padStart(2, '0')}</strong><span>Scopus</span></div>
      <div><strong>{String(counts.vak).padStart(2, '0')}</strong><span>Journals listed by the Higher Attestation Commission</span></div>
      <div><strong>{String(counts.conference).padStart(2, '0')}</strong><span>Conference Papers</span></div>
      <div><strong>{String(counts.software).padStart(2, '0')}</strong><span>Software Registrations</span></div>
    </div>
    <article class="publication-content prose"><PublicationsEn /></article>
    <div class="publication-groups">
      {types.map((type) => {
        const items = publications.filter((item) => item.type === type);
        return items.length > 0 && (
          <section>
            <h2>{typeLabels[type]}</h2>
            <div class="publication-list">
              {items.map((item) => (
                <article class="publication-card">
                  <div class="publication-meta">
                    <span>{item.year}</span>
                    <span>Research Proposition {item.relatedStatement === 'both' ? '1 + 2' : item.relatedStatement}</span>
                  </div>
                  <h3>{item.titleEn}</h3>
                  <p class="publication-authors">
                    {getEnglishAuthors(item.authors).map((author, index) => (
                      <>
                        {index > 0 && ', '}
                        <span lang={/[А-Яа-яЁё]/.test(author) ? 'ru' : undefined}>{author}</span>
                      </>
                    ))}
                  </p>
                  <p class="publication-citation" lang={/[А-Яа-яЁё]/.test(item.source) ? 'ru' : undefined}>
                    {getCitationDetails(item)}
                  </p>
                  {item.doi && <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noreferrer">DOI: {item.doi} ↗</a>}
                  {!item.doi && item.url && <a href={item.url} target="_blank" rel="noreferrer">Open source ↗</a>}
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </PageShell>
</BaseLayout>
<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-bottom: 36px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.82); }
  .stats div { padding: 20px 24px; border-right: 1px solid var(--line); }
  .stats div:last-child { border: 0; }
  .stats strong { display: block; color: var(--blue); font-size: 2rem; }
  .stats span { color: var(--muted); font-size: .72rem; font-weight: 720; text-transform: uppercase; letter-spacing: .06em; }
  .publication-content { max-width: 900px; }
  .publication-groups { margin-top: 34px; }
  .publication-groups > section { margin-top: 38px; }
  .publication-groups h2 { color: var(--blue); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .publication-list { border-top: 1px solid var(--line); }
  .publication-card { padding: 21px 0; border-bottom: 1px solid var(--line); }
  .publication-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); font-size: .68rem; text-transform: uppercase; }
  .publication-card h3 { max-width: 900px; margin: 10px 0 8px; font-family: Georgia, serif; font-size: 1.2rem; line-height: 1.42; }
  .publication-card p { margin: 3px 0; color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .publication-authors { color: #35465a !important; font-weight: 720; }
  .publication-citation { max-width: 940px; }
  .publication-card a { display: inline-block; margin-top: 12px; color: var(--blue); font-size: .78rem; font-weight: 700; }
  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats div:nth-child(2) { border-right: 0; }
    .stats div:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }
</style>
