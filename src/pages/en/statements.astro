---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageShell from '../../components/layout/PageShell.astro';
import StatementsEn from '../../content/en/statements.mdx';
---

<BaseLayout
  lang="en"
  title="Statements submitted for defence"
  description="Two connected research outcomes: a quantitative assessment of demand-side management potential and improved performance of an isolated power system through targeted control of electrical loads."
>
  <PageShell
    eyebrow="Scientific contribution · 02 statements"
    title="Statements submitted for defence"
    description="Two connected research outcomes: a quantitative assessment of demand-side management potential and improved performance of an isolated power system through targeted control of electrical loads."
  >
    <div class="statement-index">
      <a href="#statement-1"><span>01</span><strong>Audit: data → patterns → DRPI</strong><b>↓</b></a>
      <a href="#statement-2"><span>02</span><strong>Application: classes → models → effects</strong><b>↓</b></a>
    </div>

    <div class="statement-body prose"><StatementsEn /></div>
  </PageShell>
</BaseLayout>

<script>
  const articleHeadings = document.querySelectorAll('.statement-body h2');
  articleHeadings.forEach((heading, index) => heading.id = `statement-${index + 1}`);
</script>

<style>
  .statement-index { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 80px; }
  .statement-index a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 18px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: white; }
  .statement-index span { color: var(--orange); font-size: .75rem; font-weight: 800; }
  .statement-index b { color: var(--blue); }
  .statement-body { max-width: 960px; }
  .statement-body :global(h2) { margin-top: 100px; }
  .statement-body :global(blockquote) { margin: 28px 0 38px; padding: 26px 30px; border: 0; border-radius: 18px; background: #e9efff; color: var(--ink); font-family: Georgia, serif; font-size: 1.18rem; }
  .statement-body :global(ol) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0; list-style: none; counter-reset: proof; }
  .statement-body :global(li) { counter-increment: proof; padding: 18px; border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,.8); }
  .statement-body :global(li)::before { content: "0" counter(proof); display: block; margin-bottom: 12px; color: var(--orange); font-size: .66rem; font-weight: 800; }
  @media (max-width: 700px) { .statement-index, .statement-body :global(ol) { grid-template-columns: 1fr; } }
</style>
