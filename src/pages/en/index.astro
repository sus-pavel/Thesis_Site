---
/**
 * English homepage. Its structure mirrors src/pages/index.astro while rendering
 * English content directly on the /en/ route.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricCard from '../../components/ui/MetricCard.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import HomeEn from '../../content/en/home.mdx';
import { localizedHref } from '../../i18n/config';
import { siteLocales } from '../../i18n/site';

// Defence details are maintained manually here.
const defence = {
  dateTime: '29 September 2026, 13:00',
  venue: 'Empress Catherine II Saint Petersburg Mining University',
  room: 'Room 1171',
};

const sections = [
  { number: '01', href: localizedHref('/architecture', 'ru'), title: 'Solution Architecture (Russian)', text: 'Two interactive schemes: from potential assessment to targeted load control.' },
  { number: '02', href: localizedHref('/publications', 'en'), title: 'Publications', text: 'Scopus, journals listed by the Higher Attestation Commission, conferences, and a software registration.' },
  { number: '03', href: localizedHref('/downloads', 'en'), title: 'Downloads', text: 'Dissertation, dissertation abstract, presentation, and data.' },
];

const kpis = [
  { value: '−21.5%', label: 'operating costs', detail: 'from RUB 795,288 to RUB 622,858 per day' },
  { value: '−5.1%', label: 'direct Scope 1 emissions', detail: 'from 5,207 to 4,943 tCO₂/year' },
  { value: '↑ Capacity factor', label: 'renewable energy utilization', detail: 'reduced renewable energy curtailment' },
  { value: '2.2 years', label: 'payback period of the DSM solution', detail: 'a comparable battery energy storage system project has a five-year payback period, more than twice as long' },
];
---

<BaseLayout lang="en">
  <main>
    <section class="hero">
      <div class="container hero-inner">
        <div>
          <div class="hero-meta">
            <span class="pill">
              <i class="dot"></i>
              Dissertation for the Degree of Ph.D. in Engineering
            </span>
            <span>{siteLocales.en.specialty}</span>
          </div>

          <h1 class="display">
            <span class="accent">Demand-Side Management</span> for Isolated Power Grid Systems
          </h1>

          <p class="subtitle">Through Pattern Identification and Load Classification</p>

          <div class="hero-footer">
            <p>
              <strong>Research conducted at</strong><br />
              Empress Catherine II Saint Petersburg Mining University
            </p>

            <div class="actions">
              <a class="button button--primary" href={localizedHref('/architecture', 'ru')}>
                Open solution architecture (Russian) <span>↓</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="defence-section" aria-labelledby="defence-title">
      <div class="container">
        <div class="defence-card">
          <div>
            <p class="eyebrow">Upcoming Defence</p>
            <h2 id="defence-title">Dissertation Defence</h2>
          </div>
          <dl>
            <div>
              <dt>Defence Date</dt>
              <dd>{defence.dateTime}</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>{defence.venue}, {defence.room}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section section--summary">
      <div class="container summary-grid">
        <div>
          <SectionTitle
            number="00"
            eyebrow="Brief Overview"
            title="Structure of the Dissertation Research"
          />

          <div class="thesis-scheme" aria-label="Dissertation structure">
            <div class="thesis-box">
              <span>Assessment of Demand-Side Management (DSM) deployment potential</span>
            </div>

            <div class="thesis-operator">+</div>

            <div class="thesis-box">
              <span>Evaluation of DSM effects based on the classification of electrical loads</span>
            </div>

            <div class="thesis-operator">=</div>

            <div class="thesis-box thesis-box--main">
              <span>Dissertation</span>
            </div>
          </div>
        </div>

        <div>
          <div class="prose"><HomeEn /></div>
        </div>
      </div>
    </section>

    <section class="section positions-section">
      <div class="container">
        <SectionTitle
          number="01"
          eyebrow="Research Logic"
          title={"First, the deployment decision.\nThen, the control method"}
        />

        <div class="position-map">
          <article>
            <div class="position-head">
              <span>Research Proposition 1</span>
              <b>Audit</b>
            </div>

            <h3>Does the system have demand-side management potential?</h3>

            <p>
              The Demand Response Potential Index (DRPI), calculated from electricity consumption patterns obtained
              using the proposed clustering principle for Singular Spectrum Analysis (SSA) components of an electricity
              consumption time series, provides a quantitative assessment of DSM deployment potential in isolated power
              systems with hybrid generation.
            </p>

            <ol>
              <li>Input data: power system topology and component parameters</li>
              <li>SSA of electricity consumption profiles</li>
              <li>Determination of the root-mean-square amplitude and frequency of elementary components</li>
              <li>k-means clustering in the amplitude–frequency plane</li>
              <li>Reconstruction of electricity consumption patterns</li>
              <li>Calculation of DRPI and a heatmap of DSM deployment potential</li>
            </ol>
          </article>

          <div class="position-arrow" aria-hidden="true">→</div>

          <article>
            <div class="position-head">
              <span>Research Proposition 2</span>
              <b>Application</b>
            </div>

            <h3>How should electrical loads be controlled, and what effects does this produce?</h3>

            <p>
              Implementing DSM based on the proposed classification of electrical loads improves the efficiency of an
              isolated power system with hybrid generation.
            </p>

            <div class="paragraph-gap" aria-hidden="true"></div>

            <ol>
              <li>A new classification of electrical loads is proposed</li>
              <li>Each load class is assigned a dedicated control method</li>
              <li>Optimization parameters are defined for each load class</li>
              <li>Load control parameters are optimized using CC-PSO</li>
              <li>Iterative simulations are performed in MATPOWER</li>
              <li>Economic, technical, and environmental effects are calculated</li>
            </ol>
          </article>
        </div>
      </div>
    </section>

    <section class="section metrics-section">
      <div class="container">
        <SectionTitle
          number="02"
          eyebrow="Outcome of Research Proposition 2"
          title="The effects are demonstrated by economic, technical, and environmental indicators"
        />

        <div class="kpi-grid">
          {kpis.map((item, index) => <MetricCard {...item} accent={index % 3 === 1 ? 'orange' : 'blue'} />)}
        </div>

        <p class="data-note">
          <span></span>
          Results of the calculation example presented in the dissertation and dissertation abstract. The method and links between calculation blocks are shown in the solution architecture.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <SectionTitle number="→" eyebrow="Navigation" title="Three Ways to Read the Research" />

        <div class="section-links">
          {sections.map((section) => (
            <a href={section.href}>
              <span>{section.number}</span>
              <div>
                <h3>{section.title}</h3>
                <p>{section.text}</p>
              </div>
              <b>↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 78px 0 50px;
  }

  .hero-inner {
    display: grid;
    gap: 55px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 34px;
    color: #768394;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .subtitle {
    max-width: 850px;
    margin: 22px 0 0;
    color: #556276;
    font-family: Georgia, serif;
    font-size: clamp(1.18rem, 2.2vw, 1.65rem);
  }

  .hero-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    margin-top: 46px;
  }

  .hero-footer p {
    margin: 0;
    color: #657284;
    font-size: .8rem;
  }

  .hero-footer strong {
    color: var(--ink);
    font-size: .92rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .defence-section {
    padding: 0 0 clamp(64px, 8vw, 96px);
  }

  .defence-card {
    display: grid;
    grid-template-columns: minmax(220px, .7fr) 1.3fr;
    gap: clamp(28px, 6vw, 72px);
    padding: clamp(26px, 4vw, 46px);
    border: 1px solid rgba(24, 86, 216, .24);
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(24, 86, 216, .1), rgba(255, 255, 255, .9));
    box-shadow: 0 18px 60px rgba(42, 60, 86, .07);
  }

  .defence-card h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .defence-card dl {
    display: grid;
    gap: 24px;
    margin: 0;
  }

  .defence-card dl div + div {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .defence-card dt {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .defence-card dd {
    margin: 6px 0 0;
    color: var(--ink);
    font-family: Georgia, serif;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.45;
  }

  .section--summary {
    background: rgba(255, 255, 255, .62);
    border-block: 1px solid var(--line);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 7vw;
  }

  .summary-grid :global(h2) {
    font-size: 2rem;
  }

  .thesis-scheme {
    margin-top: 28px;
    display: grid;
    gap: 10px;
    max-width: 520px;
  }

  .thesis-box {
    position: relative;
    padding: 18px 20px;
    border: 1px solid rgba(47, 91, 216, .22);
    border-radius: 18px;
    background: rgba(255, 255, 255, .82);
    box-shadow: 0 18px 42px rgba(36, 54, 79, .07);
    color: #2f3b4d;
    font-size: clamp(.92rem, 1.4vw, 1.08rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .thesis-box--main {
    border-color: rgba(47, 91, 216, .34);
    background: linear-gradient(135deg, rgba(47, 91, 216, .11), rgba(255, 255, 255, .88));
    color: var(--blue);
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
  }

  .thesis-box span { display: block; }
  .thesis-operator { justify-self: center; color: var(--orange); font-size: 1.05rem; font-weight: 900; line-height: 1; }
  .positions-section { background: rgba(255, 255, 255, .4); }
  .position-map { display: grid; grid-template-columns: 1fr auto 1fr; gap: 22px; align-items: stretch; }
  .position-map article { padding: clamp(24px, 3.5vw, 42px); border: 1px solid var(--line); border-radius: 22px; background: rgba(255, 255, 255, .88); }
  .position-head { display: flex; justify-content: space-between; gap: 20px; color: var(--blue); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .position-head b { color: var(--orange); }
  .position-map h3 { margin: 30px 0 14px; font-size: clamp(1.5rem, 3vw, 2.35rem); line-height: 1.08; letter-spacing: -.035em; }
  .position-map p { color: #536176; font-family: Georgia, serif; }
  .paragraph-gap { height: 48px; }
  .position-map ol { margin: 28px 0 0; padding: 0; list-style: none; counter-reset: stage; }
  .position-map li { counter-increment: stage; padding: 10px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: .78rem; }
  .position-map li::before { content: "0" counter(stage); display: inline-block; width: 30px; color: var(--blue); font-weight: 800; }
  .position-arrow { align-self: center; color: var(--blue); font-size: 1.8rem; }
  .metrics-section { background: #eef3f7; }
  .kpi-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .data-note { display: flex; align-items: center; gap: 9px; margin: 20px 0 0; color: #748191; font-size: .7rem; }
  .data-note span { width: 7px; height: 7px; border-radius: 50%; background: var(--orange); flex: 0 0 auto; }
  .section-links { border-top: 1px solid var(--line); }
  .section-links a { display: grid; grid-template-columns: 70px 1fr auto; gap: 28px; align-items: center; padding: 28px 4px; border-bottom: 1px solid var(--line); transition: padding .2s ease, background .2s ease; }
  .section-links a:hover { padding-inline: 18px; background: rgba(255, 255, 255, .72); }
  .section-links span { color: var(--orange); font-size: .72rem; font-weight: 800; }
  .section-links h3 { margin: 0; font-size: 1.4rem; }
  .section-links p { margin: 4px 0 0; color: var(--muted); font-size: .82rem; }
  .section-links b { color: var(--blue); font-size: 1.4rem; }

  @media (max-width: 950px) { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }

  @media (max-width: 800px) {
    .hero { min-height: auto; }
    .hero-meta, .hero-footer { align-items: flex-start; flex-direction: column; }
    .summary-grid, .defence-card { grid-template-columns: 1fr; }
    .thesis-scheme { max-width: none; }
    .thesis-box { padding: 16px 18px; border-radius: 16px; }
    .position-map { grid-template-columns: 1fr; }
    .position-arrow { transform: rotate(90deg); justify-self: center; }
    .paragraph-gap { height: 16px; }
    .section-links a { grid-template-columns: 35px 1fr auto; gap: 10px; }
  }

  @media (max-width: 550px) { .kpi-grid { grid-template-columns: 1fr; } }
</style>
