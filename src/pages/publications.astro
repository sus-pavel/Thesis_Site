---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import PublicationsRu from '../content/ru/publications.mdx';
import PublicationsEn from '../content/en/publications.mdx';
---
<BaseLayout title="Публикации">
  <PageShell eyebrow="Апробация результатов" title="Публикации и программная реализация" description="Структура подготовлена для проверенных библиографических записей, DOI, индексации и ссылок на полный текст.">
    <div class="stats">
      <div><strong>02</strong><span>Scopus · placeholder</span></div>
      <div><strong>02</strong><span>ВАК · placeholder</span></div>
      <div><strong>01</strong><span>программа для ЭВМ</span></div>
    </div>
    <article class="publication-content language-content prose" data-lang="ru"><PublicationsRu /></article>
    <article class="publication-content language-content prose" data-lang="en"><PublicationsEn /></article>
  </PageShell>
</BaseLayout>
<style>
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-bottom: 68px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.82); }
  .stats div { padding: 24px; border-right: 1px solid var(--line); }
  .stats div:last-child { border: 0; }
  .stats strong { display: block; color: var(--blue); font-size: 2rem; }
  .stats span { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
  .publication-content { max-width: 900px; }
  .publication-content :global(h3) { margin-top: 60px; padding-bottom: 12px; border-bottom: 1px solid var(--line); color: var(--blue); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .publication-content :global(li) { margin: 10px 0; padding: 17px 20px; border: 1px solid var(--line); border-radius: 12px; background: white; list-style: none; }
  .publication-content :global(ul) { padding: 0; }
  @media (max-width: 650px) { .stats { grid-template-columns: 1fr; } .stats div { border-right: 0; border-bottom: 1px solid var(--line); } }
</style>
