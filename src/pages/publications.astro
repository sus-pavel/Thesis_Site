---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import PublicationsRu from '../content/ru/publications.mdx';
import publications from '../../public/data/publications/publications.json';

const typeLabels: Record<string, string> = {
  scopus: 'Scopus',
  vak: 'Журналы ВАК',
  conference: 'Конференции',
  other: 'Прочие',
  software: 'Программы для ЭВМ',
};
const types = Object.keys(typeLabels);
const counts = Object.fromEntries(types.map((type) => [type, publications.filter((item) => item.type === type).length]));
---
<BaseLayout title="Публикации" description="Публикации и программы для ЭВМ по теме диссертационного исследования.">
  <PageShell eyebrow="АПРОБАЦИЯ РЕЗУЛЬТАТОВ" title="Публикации и программы для ЭВМ">
    <div class="stats">
      <div><strong>{String(counts.scopus).padStart(2, '0')}</strong><span>Scopus</span></div>
      <div><strong>{String(counts.vak).padStart(2, '0')}</strong><span>Журналы ВАК</span></div>
      <div><strong>{String(counts.software).padStart(2, '0')}</strong><span>Программы для ЭВМ</span></div>
    </div>
    <article class="publication-content prose"><PublicationsRu /></article>
    <div class="publication-groups">
      {types.map((type) => {
        const items = publications.filter((item) => item.type === type);
        return items.length > 0 && (
          <section>
            <h2>{typeLabels[type]}</h2>
            <div class="publication-list">
              {items.map((item) => (
                <article class="publication-card">
                  <div class="publication-meta">
                    <span>{item.year}</span>
                    <span>Положение {item.relatedStatement === 'both' ? '1 + 2' : item.relatedStatement}</span>
                    {item.isPlaceholder && <span class="placeholder">Демонстрационная запись</span>}
                  </div>
                  <h3>{item.titleRu}</h3>
                  <p>{item.authors.join(', ')}</p>
                  <p>{item.source}{item.registrationNumber ? ` · № ${item.registrationNumber}` : ''}</p>
                  {item.doi && <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noreferrer">DOI: {item.doi} ↗</a>}
                  {!item.doi && item.url && <a href={item.url} target="_blank" rel="noreferrer">Открыть источник ↗</a>}
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </PageShell>
</BaseLayout>
<style>
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); margin-bottom: 68px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.82); }
  .stats div { padding: 24px; border-right: 1px solid var(--line); }
  .stats div:last-child { border: 0; }
  .stats strong { display: block; color: var(--blue); font-size: 2rem; }
  .stats span { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
  .publication-content { max-width: 900px; }
  .publication-groups { margin-top: 60px; }
  .publication-groups > section { margin-top: 56px; }
  .publication-groups h2 { color: var(--blue); font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; }
  .publication-list { border-top: 1px solid var(--line); }
  .publication-card { padding: 24px 0; border-bottom: 1px solid var(--line); }
  .publication-meta { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); font-size: .68rem; text-transform: uppercase; }
  .publication-meta .placeholder { color: #a75a10; }
  .publication-card h3 { max-width: 820px; margin: 12px 0 8px; font-family: Georgia, serif; font-size: 1.28rem; }
  .publication-card p { margin: 3px 0; color: var(--muted); font-size: .82rem; }
  .publication-card a { display: inline-block; margin-top: 12px; color: var(--blue); font-size: .78rem; font-weight: 700; }
  @media (max-width: 650px) { .stats { grid-template-columns: 1fr; } .stats div { border-right: 0; border-bottom: 1px solid var(--line); } }
</style>
