---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageShell from '../components/layout/PageShell.astro';
import DownloadsRu from '../content/ru/downloads.mdx';
import DownloadsEn from '../content/en/downloads.mdx';
const files = [
  { code: 'PDF · RU', title: 'Автореферат', file: 'autoreferat.pdf' },
  { code: 'PDF · RU', title: 'Диссертация', file: 'dissertation.pdf' },
  { code: 'PDF · RU', title: 'Презентация', file: 'presentation.pdf' },
  { code: 'PDF · RU / EN', title: 'Билингвальная брошюра', file: 'brochure.pdf' },
  { code: 'CSV · JSON', title: 'Интерактивные данные', file: '../data/' },
];
---
<BaseLayout title="Материалы для загрузки">
  <PageShell eyebrow="Открытые материалы" title="Документы и данные исследования" description="Единая точка доступа к утверждённым PDF-версиям и машиночитаемым результатам расчётов.">
    <div class="language-content prose intro" data-lang="ru"><DownloadsRu /></div>
    <div class="language-content prose intro" data-lang="en"><DownloadsEn /></div>
    <div class="download-grid">
      {files.map((item, index) => (
        <article class="download-card">
          <div><span>{item.code}</span><b>{String(index + 1).padStart(2, '0')}</b></div>
          <h2>{item.title}</h2>
          <p><code>public/downloads/{item.file}</code></p>
          <button type="button" disabled><i></i> ожидается файл</button>
        </article>
      ))}
    </div>
  </PageShell>
</BaseLayout>
<style>
  .intro { margin-bottom: 50px; }
  .download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
  .download-card { min-height: 245px; display: flex; flex-direction: column; padding: 26px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255,255,255,.88); }
  .download-card > div { display: flex; justify-content: space-between; color: #8a97a5; font-size: .66rem; font-weight: 800; letter-spacing: .08em; }
  h2 { margin: 34px 0 7px; font-size: 1.75rem; letter-spacing: -.03em; }
  p { margin: 0; color: var(--muted); font-size: .7rem; overflow-wrap: anywhere; }
  button { width: fit-content; margin-top: auto; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; color: #7b8795; background: #f4f7f9; font-size: .68rem; font-weight: 800; text-transform: uppercase; }
  button i { display: inline-block; width: 6px; height: 6px; margin-right: 7px; border-radius: 50%; background: var(--orange); }
  @media (max-width: 650px) { .download-grid { grid-template-columns: 1fr; } }
</style>
