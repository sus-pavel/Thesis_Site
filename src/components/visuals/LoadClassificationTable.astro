---
const rows = [
  ['Вариативная', 'Ограничение / модуляция', 'Энергия в окне'],
  ['Скользящая', 'Сдвиг цикла', 'Форма цикла'],
  ['Гибкая', 'Заряд / разряд', 'SoC, мощность'],
  ['Мигрирующая', 'Выбор центра питания', 'Доступность'],
  ['Пассивная', 'Не управляется', 'Запрет управления'],
];
---
<div class="table-wrap">
  <table>
    <thead><tr><th>Класс</th><th>DR-воздействие</th><th>Ключевое ограничение</th></tr></thead>
    <tbody>{rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
  </table>
</div>
<style>
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 16px; }
  table { width: 100%; border-collapse: collapse; background: white; font-size: .84rem; }
  th, td { padding: 14px 16px; border-bottom: 1px solid var(--line); text-align: left; }
  th { color: var(--blue); font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; }
  tr:last-child td { border-bottom: 0; }
</style>
