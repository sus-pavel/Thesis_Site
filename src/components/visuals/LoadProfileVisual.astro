---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import {
  csvParse,
  curveMonotoneX,
  extent,
  group,
  line,
  scaleLinear,
  scaleTime,
  timeFormat,
} from 'd3';

type LoadPoint = {
  timestamp: Date;
  feederId: string;
  powerKw: number;
};

const csvPath = resolve('public/data/load_profiles/placeholder_load_profile.csv');
const csvText = await readFile(csvPath, 'utf8');
const points = csvParse(csvText, (row): LoadPoint | null => {
  const timestamp = new Date(row.timestamp ?? '');
  const powerKw = Number(row.p_kw);
  const feederId = row.feeder_id?.trim() ?? '';

  if (!feederId || Number.isNaN(timestamp.getTime()) || !Number.isFinite(powerKw)) return null;
  return { timestamp, feederId, powerKw };
}).filter((point): point is LoadPoint => point !== null);

const feederNumber = (id: string) => Number(id.replace(/\D/g, '')) || 0;
const series = Array.from(group(points, (point) => point.feederId), ([id, values]) => ({
  id,
  values: values.sort((a, b) => a.timestamp.getTime() - b.timestamp.getTime()),
})).sort((a, b) => feederNumber(a.id) - feederNumber(b.id));

const [dateMin, dateMax] = extent(points, (point) => point.timestamp) as [Date, Date];
const width = 1400;
const height = 820;
const columns = 2;
const rows = 4;
const marginX = 48;
const marginTop = 34;
const marginBottom = 42;
const gapX = 48;
const gapY = 22;
const panelWidth = (width - marginX * 2 - gapX) / columns;
const panelHeight = (height - marginTop - marginBottom - gapY * (rows - 1)) / rows;
const plotLeft = 62;
const plotRight = 16;
const plotTop = 34;
const plotBottom = 28;
const plotWidth = panelWidth - plotLeft - plotRight;
const plotHeight = panelHeight - plotTop - plotBottom;
const xScale = scaleTime().domain([dateMin, dateMax]).range([0, plotWidth]);
const dateLabel = timeFormat('%d.%m');
const xTicks = [dateMin, new Date((dateMin.getTime() + dateMax.getTime()) / 2), dateMax];

const panels = series.map((item, index) => {
  const [rawMin, rawMax] = extent(item.values, (point) => point.powerKw) as [number, number];
  const padding = Math.max((rawMax - rawMin) * 0.12, 1);
  const yScale = scaleLinear()
    .domain([Math.max(0, rawMin - padding), rawMax + padding])
    .range([plotHeight, 0]);
  const path = line<LoadPoint>()
    .x((point) => xScale(point.timestamp))
    .y((point) => yScale(point.powerKw))
    .curve(curveMonotoneX)(item.values) ?? '';

  return {
    ...item,
    index,
    column: index % columns,
    row: Math.floor(index / columns),
    x: marginX + (index % columns) * (panelWidth + gapX),
    y: marginTop + Math.floor(index / columns) * (panelHeight + gapY),
    path,
    rawMin,
    rawMax,
    yMin: yScale(rawMin),
    yMax: yScale(rawMax),
  };
});
---

<figure class="load-profile-figure">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="load-profile-title load-profile-description">
    <title id="load-profile-title">Временные ряды нагрузки по восьми фидерам</title>
    <desc id="load-profile-description">
      Получасовые значения активной мощности фидеров P1, P2 и P4–P9 за период с 1 по 17 января 2014 года.
    </desc>

    <rect width={width} height={height} fill="#fff" />
    {panels.map((panel) => (
      <g transform={`translate(${panel.x} ${panel.y})`}>
        <text x="0" y="17" class="feeder-label">{panel.id}</text>
        <text x={panelWidth} y="17" text-anchor="end" class="range-label">
          {Math.round(panel.rawMin).toLocaleString('ru-RU')}–{Math.round(panel.rawMax).toLocaleString('ru-RU')} кВт
        </text>

        <g transform={`translate(${plotLeft} ${plotTop})`}>
          {xTicks.map((tick) => (
            <line x1={xScale(tick)} x2={xScale(tick)} y1="0" y2={plotHeight} class="grid-line" />
          ))}
          <line x1="0" x2={plotWidth} y1={panel.yMin} y2={panel.yMin} class="grid-line horizontal" />
          <line x1="0" x2={plotWidth} y1={panel.yMax} y2={panel.yMax} class="grid-line horizontal" />
          <path d={panel.path} class="series-line" />

          <text x="-10" y={panel.yMax + 4} text-anchor="end" class="axis-label">{Math.round(panel.rawMax)}</text>
          <text x="-10" y={panel.yMin + 4} text-anchor="end" class="axis-label">{Math.round(panel.rawMin)}</text>

          {panel.row === rows - 1 && xTicks.map((tick, tickIndex) => (
            <text
              x={xScale(tick)}
              y={plotHeight + 20}
              text-anchor={tickIndex === 0 ? 'start' : tickIndex === xTicks.length - 1 ? 'end' : 'middle'}
              class="axis-label date-label"
            >
              {dateLabel(tick)}
            </text>
          ))}
        </g>
      </g>
    ))}
  </svg>
</figure>

<style>
  .load-profile-figure { aspect-ratio: 1400 / 820; margin: 14px 14px 0; overflow: hidden; border: 1px solid #e3e9ee; border-radius: 14px; background: #fff; }
  svg { width: 100%; height: 100%; }
  .feeder-label { fill: #18212f; font: 800 21px Inter, ui-sans-serif, system-ui, sans-serif; letter-spacing: .04em; }
  .range-label { fill: #7a8999; font: 700 15px Inter, ui-sans-serif, system-ui, sans-serif; }
  .axis-label { fill: #8b98a6; font: 650 13px Inter, ui-sans-serif, system-ui, sans-serif; }
  .date-label { letter-spacing: .03em; }
  .grid-line { stroke: #dbe4ec; stroke-width: 1; stroke-dasharray: 4 6; vector-effect: non-scaling-stroke; }
  .grid-line.horizontal { stroke-dasharray: none; opacity: .65; }
  .series-line { fill: none; stroke: #1856d8; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
</style>
