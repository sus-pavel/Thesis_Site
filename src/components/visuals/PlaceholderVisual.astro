---
import type { VisualDefinition } from '../../data/visuals';
interface Props { visual: VisualDefinition; index?: number; }
const { visual, index = 0 } = Astro.props;
const seed = index + 1;
---
<article class="visual-card">
  <div class="visual-top">
    <span class="pill"><i class="dot"></i> data pending</span>
    <span class="visual-number">{String(index + 1).padStart(2, '0')}</span>
  </div>
  <div class={`visual-stage kind-${visual.kind}`} aria-hidden="true">
    <svg viewBox="0 0 720 390" role="img">
      <defs>
        <linearGradient id={`fade-${visual.id}`} x1="0" y1="0" x2="1" y2="0">
          <stop stop-color="#1856d8" stop-opacity=".92"/>
          <stop offset="1" stop-color="#f28c28" stop-opacity=".82"/>
        </linearGradient>
        <pattern id={`grid-${visual.id}`} width="42" height="42" patternUnits="userSpaceOnUse">
          <path d="M 42 0 L 0 0 0 42" fill="none" stroke="#d9e3eb" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="720" height="390" fill={`url(#grid-${visual.id})`} />
      {visual.kind === 'line' && (
        <>
          <path d={`M20 ${260-seed*2} C120 245, 155 140, 250 194 S390 308, 470 160 S600 94, 700 ${110+seed}`} fill="none" stroke={`url(#fade-${visual.id})`} stroke-width="7" />
          <path d="M20 300 C145 270, 180 315, 290 244 S460 210, 700 250" fill="none" stroke="#9eb1c3" stroke-width="3" stroke-dasharray="7 8"/>
        </>
      )}
      {visual.kind === 'map' && (
        <>
          <path d="M85 225 145 92l98-36 90 45 94-9 68 55 128 15 33 75-74 62-150-1-85 40-106-42-116 2z" fill="#dfe8ef" stroke="#93a8bb" stroke-width="2"/>
          {[130,210,294,366,451,532,604].map((x, i) => <circle cx={x} cy={130 + (i%3)*60} r={7+i%2*4} fill={i%2 ? '#f28c28' : '#1856d8'} opacity=".88"/>)}
        </>
      )}
      {visual.kind === 'system' && (
        <>
          {[100,280,460,620].map((x, i) => <rect x={x-48} y={145+(i%2)*50} width="96" height="72" rx="12" fill={i===3 ? '#fff1df' : '#e4ecff'} stroke={i===3 ? '#f28c28' : '#1856d8'} stroke-width="2"/>)}
          <path d="M148 181H232M328 220H412M508 181H572" stroke="#53657a" stroke-width="4" stroke-dasharray="8 8"/>
          <circle cx="360" cy="82" r="32" fill="#1856d8"/><path d="m365 55-20 30h16l-6 25 25-35h-17z" fill="#fff"/>
        </>
      )}
      {visual.kind === 'matrix' && (
        <g transform="translate(110 36) rotate(-8 250 160)">
          {Array.from({length: 9}).map((_, r) => Array.from({length: 14}).map((_, c) =>
            <rect x={c*35} y={r*35} width="31" height="31" rx="3" fill={`hsl(${215 + (r+c)%4*7} 72% ${88 - ((r*3+c*5)%30)}%)`} />
          ))}
        </g>
      )}
      {visual.kind === 'scatter' && (
        <>
          <path d="M70 325H680M70 325V40" stroke="#75869a" stroke-width="2"/>
          {Array.from({length: 24}).map((_, i) => <circle cx={105 + ((i*73)%545)} cy={70 + ((i*47)%230)} r={5+(i%4)*2} fill={i%3===0 ? '#f28c28' : '#1856d8'} opacity=".74"/>)}
        </>
      )}
      {visual.kind === 'clusters' && (
        <>
          {[0,1,2].map((g) => <path d={`M30 ${110+g*92} C130 ${40+g*100}, 220 ${170+g*65}, 330 ${105+g*90} S550 ${45+g*110}, 700 ${130+g*80}`} fill="none" stroke={['#1856d8','#f28c28','#5b8c78'][g]} stroke-width="5" opacity=".82"/>)}
        </>
      )}
      {visual.kind === 'heatmap' && (
        <g transform="translate(88 42)">
          {Array.from({length: 7}).map((_, r) => Array.from({length: 12}).map((_, c) =>
            <rect x={c*46} y={r*42} width="41" height="37" rx="4" fill={`hsl(${216 - ((r*8+c*5)%45)} 75% ${91 - ((r*13+c*7)%45)}%)`} />
          ))}
        </g>
      )}
      {visual.kind === 'table' && (
        <g transform="translate(54 58)">
          {[0,1,2,3,4].map((r) => <rect x="0" y={r*55} width="612" height="43" rx="8" fill={r%2 ? '#f1f5f8' : '#e5ecf2'}/>)}
          {[130,300,475].map((x) => <path d={`M${x} 0V268`} stroke="#c3d0db"/>)}
        </g>
      )}
      {visual.kind === 'flow' && (
        <>
          {[90,270,450,630].map((x, i) => <circle cx={x} cy={195 + (i%2 ? -50 : 50)} r="48" fill={i%2 ? '#fff0df' : '#e4ecff'} stroke={i%2 ? '#f28c28' : '#1856d8'} stroke-width="3"/>)}
          <path d="M135 230 220 175M320 160 400 220M500 225 580 170" stroke="#708196" stroke-width="4" marker-end="url(#arrow)"/>
        </>
      )}
      {visual.kind === 'bars' && (
        <g transform="translate(90 55)">
          {[0,1,2,3].map((g) => <>
            <rect x={g*145} y={235-(g+1)*38} width="44" height={(g+1)*38} rx="5" fill="#1856d8"/>
            <rect x={g*145+50} y={245-(4-g)*30} width="44" height={(4-g)*30} rx="5" fill="#f28c28"/>
          </>)}
          <path d="M0 250H570" stroke="#718297" stroke-width="2"/>
        </g>
      )}
      {visual.kind === 'emissions' && (
        <>
          <rect x="135" y="76" width="150" height="244" rx="10" fill="#b8c7d4"/><rect x="435" y="112" width="150" height="208" rx="10" fill="#3f866b"/>
          <text x="210" y="62" text-anchor="middle" fill="#18212f" font-size="28" font-weight="800">5207</text>
          <text x="510" y="98" text-anchor="middle" fill="#18212f" font-size="28" font-weight="800">4943</text>
        </>
      )}
    </svg>
  </div>
  <div class="visual-copy">
    <p class="eyebrow">Visualization placeholder</p>
    <h3>{visual.title}</h3>
    <dl>
      <div><dt>DATA</dt><dd>{visual.dataFile}</dd></div>
      <div><dt>FIGURE</dt><dd>{visual.figureFile}</dd></div>
    </dl>
  </div>
</article>

<style>
  .visual-card { overflow: hidden; height: 100%; border: 1px solid var(--line); border-radius: 22px; background: rgba(255,255,255,.96); box-shadow: 0 26px 80px rgba(32,56,86,.12); }
  .visual-top { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px 0; }
  .visual-top .pill { border: 0; padding-left: 0; background: transparent; }
  .visual-number { color: #a0adba; font-size: .72rem; font-weight: 800; }
  .visual-stage { height: min(39vh, 390px); min-height: 250px; margin: 8px 14px 0; overflow: hidden; border: 1px solid #e3e9ee; border-radius: 14px; background: #f9fbfc; }
  .visual-stage svg { width: 100%; height: 100%; }
  .visual-copy { padding: 22px 24px 25px; }
  .visual-copy .eyebrow { margin-bottom: 6px; font-size: .62rem; }
  h3 { margin: 0; font-size: clamp(1.25rem, 2.3vw, 2rem); line-height: 1.13; letter-spacing: -.025em; }
  dl { display: grid; gap: 5px; margin: 18px 0 0; }
  dl div { display: grid; grid-template-columns: 58px 1fr; gap: 8px; }
  dt { color: #8794a3; font-size: .61rem; font-weight: 800; letter-spacing: .08em; }
  dd { margin: 0; overflow-wrap: anywhere; color: #566478; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .68rem; }
</style>
