---
interface Props { label?: string; tone?: 'blue' | 'orange'; }
const { label = 'Ключевой вывод', tone = 'blue' } = Astro.props;
---
<aside class={`callout ${tone}`}>
  <p>{label}</p>
  <div><slot /></div>
</aside>
<style>
  .callout { margin: 28px 0; padding: 22px 24px; border-left: 3px solid var(--blue); background: rgba(24,86,216,.06); }
  .callout.orange { border-color: var(--orange); background: rgba(242,140,40,.08); }
  .callout > p { margin: 0 0 6px; color: var(--blue); font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .callout.orange > p { color: #a75a10; }
  .callout :global(p) { margin: 0; color: var(--ink); }
</style>
