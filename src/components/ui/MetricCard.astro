---
interface Props { value: string; unit?: string; label: string; detail?: string; accent?: 'blue' | 'orange'; }
const { value, unit, label, detail, accent = 'blue' } = Astro.props;
---
<article class={`metric-card card ${accent}`}>
  <p class="value">{value} {unit && <small>{unit}</small>}</p>
  <h3>{label}</h3>
  {detail && <p class="detail">{detail}</p>}
</article>
<style>
  .metric-card { min-height: 205px; padding: 26px; }
  .metric-card::before { content: ""; display: block; width: 38px; height: 3px; margin-bottom: 30px; background: var(--blue); }
  .metric-card.orange::before { background: var(--orange); }
  .value { margin: 0; font-size: clamp(2.1rem, 4vw, 3.5rem); font-weight: 800; line-height: 1; letter-spacing: -.05em; }
  .value small { color: var(--muted); font-size: .88rem; letter-spacing: 0; }
  h3 { margin: 18px 0 5px; font-size: .92rem; }
  .detail { margin: 0; color: var(--muted); font-size: .78rem; }
</style>
