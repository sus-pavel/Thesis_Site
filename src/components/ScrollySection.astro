---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section id={id} class="scroll-section" data-section={id}>
  <div class="mobile-viz" data-mobile-viz={id} aria-label={`Визуализация раздела ${id}`}></div>
  <div class="section-copy">
    <span class="section-index" aria-hidden="true"></span>
    <slot />
  </div>
</section>
