---
interface Props { visual: string; number: string; label?: string; title: string; }
const { visual, number, label = 'Этап исследования', title } = Astro.props;
---
<section class="story-step" data-story-step data-visual={visual} id={`section-${visual}`}>
  <p class="step-label"><span>{number}</span>{label}</p>
  <h2>{title}</h2>
  <div class="step-body"><slot /></div>
  <a class="step-data" href={`#visual-${visual}`}>Смотреть визуализацию <span>↗</span></a>
</section>
<style>
  .story-step { min-height: 78vh; display: flex; flex-direction: column; justify-content: center; padding: 80px 12px 80px 0; opacity: .36; transition: opacity .45s ease; }
  .story-step.is-active { opacity: 1; }
  .step-label { display: flex; gap: 10px; margin: 0 0 17px; color: var(--blue); font-size: .68rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .step-label span { color: var(--orange); }
  h2 { margin: 0 0 24px; font-size: clamp(2rem, 4.6vw, 4.3rem); line-height: 1.02; letter-spacing: -.048em; }
  .step-body { max-width: 600px; color: #536176; font-family: Georgia, serif; font-size: 1.08rem; }
  .step-body :global(p) { margin: 0 0 1em; }
  .step-body :global(strong) { color: var(--ink); }
  .step-data { width: fit-content; margin-top: 16px; color: var(--blue); font-size: .75rem; font-weight: 800; }
  @media (max-width: 900px) { .story-step { min-height: auto; padding: 70px 0 30px; opacity: 1; } }
</style>
