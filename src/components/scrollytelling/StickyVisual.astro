---
import PlaceholderVisual from '../visuals/PlaceholderVisual.astro';
import type { VisualDefinition } from '../../data/visuals';
interface Props { visuals: VisualDefinition[]; }
const { visuals } = Astro.props;
---
<aside class="sticky-wrap" aria-label="Область визуализации">
  <div class="sticky-visual">
    {visuals.map((visual, index) => (
      <div class:list={['visual-panel', { 'is-active': index === 0 }]} data-visual-panel={visual.id} id={`visual-${visual.id}`}>
        <PlaceholderVisual visual={visual} index={index} />
      </div>
    ))}
  </div>
</aside>
<style>
  .sticky-wrap { position: relative; min-width: 0; }
  .sticky-visual { position: sticky; top: 90px; height: calc(100vh - 118px); min-height: 590px; }
  .visual-panel { position: absolute; inset: 0; opacity: 0; transform: translateY(14px) scale(.985); pointer-events: none; transition: opacity .45s ease, transform .45s ease; }
  .visual-panel.is-active { opacity: 1; transform: none; pointer-events: auto; }
  @media (max-width: 900px) {
    .sticky-wrap { display: none; }
  }
</style>
