---
/**
 * Runtime scrollytelling: связывает активный текстовый шаг со sticky-визуализацией.
 * Менять только при изменении поведения прокрутки или мобильного режима.
 */
import StickyVisual from './StickyVisual.astro';
import type { VisualDefinition } from '../../data/visuals';
interface Props { visuals: VisualDefinition[]; }
const { visuals } = Astro.props;
---
<div class="story-shell container" data-scroll-story>
  <div class="story-copy"><slot /></div>
  <StickyVisual visuals={visuals} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-scroll-story]').forEach((shell) => {
    if (shell.dataset.ready === 'true') return;
    shell.dataset.ready = 'true';
    const steps = [...shell.querySelectorAll<HTMLElement>('[data-story-step]')];
    const panels = [...shell.querySelectorAll<HTMLElement>('[data-visual-panel]')];
    const setActive = (id: string) => {
      steps.forEach((step) => step.classList.toggle('is-active', step.dataset.visual === id));
      panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.visualPanel === id));
    };

    steps.forEach((step) => {
      const id = step.dataset.visual;
      const panel = panels.find((item) => item.dataset.visualPanel === id);
      const mobileSlot = step.querySelector<HTMLElement>('[data-mobile-visual]');
      const card = panel?.querySelector<HTMLElement>('.visual-card');
      if (mobileSlot && card) mobileSlot.append(card.cloneNode(true));
    });

    if (steps[0]?.dataset.visual) setActive(steps[0].dataset.visual);
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top))[0];
      const id = (visible?.target as HTMLElement | undefined)?.dataset.visual;
      if (id) setActive(id);
    }, { rootMargin: '-36% 0px -46% 0px', threshold: 0 });
    steps.forEach((step) => observer.observe(step));
  });
</script>

<style>
  .story-shell { display: grid; grid-template-columns: minmax(0, .86fr) minmax(480px, 1.14fr); gap: clamp(36px, 6vw, 88px); padding-top: 35px; padding-bottom: 100px; }
  @media (max-width: 900px) { .story-shell { grid-template-columns: 1fr; } }
</style>
