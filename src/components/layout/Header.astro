---
import { defaultLanguage, localizedHref, type Language } from '../../i18n/config';
import { getNavigation } from '../../i18n/navigation';
import { siteLocales, siteUi } from '../../i18n/site';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: Language;
  languagePath?: string;
}

const { lang = defaultLanguage, languagePath } = Astro.props;
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL;
const navigation = getNavigation(lang);
const siteConfig = siteLocales[lang];
const ui = siteUi[lang];
const normalizePath = (path: string) => path.replace(base, '/').replace(/\/$/, '') || '/';
---

<header>
  <div class="container header-inner">
    <a class="brand" href={localizedHref('/', lang)} aria-label={ui.homeAria}>
      <span class="brand-mark" aria-hidden="true">
        <i></i><i></i><i></i>
      </span>
      <span>{siteConfig.shortTitle}</span>
    </a>

    <nav class="primary-nav" aria-label={ui.primaryNavigation}>
      {navigation.map((item) => (
        <a href={item.href} aria-current={normalizePath(pathname) === normalizePath(new URL(item.href, Astro.url).pathname) ? 'page' : undefined}>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="language-control">
      <LanguageSwitcher routePathOverride={languagePath} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid rgba(215,224,231,.85);
    background: rgba(244,247,249,.88);
    backdrop-filter: blur(18px);
  }
  .header-inner { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 28px; min-height: 64px; }
  .brand { min-height: 40px; display: inline-flex; align-items: center; gap: 11px; width: fit-content; font-size: .76rem; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .brand-mark { display: flex; align-items: end; gap: 3px; width: 23px; height: 18px; }
  .brand-mark i { display: block; width: 5px; border-radius: 2px 2px 0 0; background: var(--blue); }
  .brand-mark i:nth-child(1) { height: 8px; }
  .brand-mark i:nth-child(2) { height: 17px; background: var(--orange); }
  .brand-mark i:nth-child(3) { height: 12px; }
  .primary-nav { display: flex; align-items: center; gap: 22px; }
  .primary-nav a { min-height: 40px; display: inline-flex; align-items: center; position: relative; color: #526173; font-size: .76rem; font-weight: 700; }
  .primary-nav a:hover, .primary-nav a[aria-current="page"] { color: var(--ink); }
  .primary-nav a[aria-current="page"]::after { content: ""; position: absolute; left: 0; right: 0; bottom: -21px; height: 2px; background: var(--blue); }
  @media (max-width: 950px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .primary-nav {
      grid-column: 1 / -1;
      order: 3;
      width: 100%;
      padding: 0 0 11px;
      gap: 18px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .primary-nav::-webkit-scrollbar { display: none; }
    .primary-nav a { flex: 0 0 auto; min-height: 36px; font-size: .72rem; }
    .primary-nav a[aria-current="page"]::after { bottom: -10px; }
    .header-inner { gap: 8px 20px; }
  }
</style>
