---
import { getRoutePath, localizedHref } from '../../i18n/config';

const routePath = getRoutePath(Astro.url.pathname, 'ru');
const ruHref = localizedHref(routePath, 'ru');
const enHref = localizedHref(routePath, 'en');
const isEnglish = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/').startsWith('/en/');
---

<nav class="language-switcher" aria-label={isEnglish ? 'Language selection' : 'Выбор языка'}>
  <a href={ruHref} lang="ru" hreflang="ru" aria-current={!isEnglish ? 'page' : undefined}>RU</a>
  <span aria-hidden="true">/</span>
  <a href={enHref} lang="en" hreflang="en" aria-current={isEnglish ? 'page' : undefined}>EN</a>
</nav>

<style>
  .language-switcher { display: flex; align-items: center; gap: 7px; color: #8a96a4; font-size: .72rem; font-weight: 800; }
  a { padding: 4px 2px; color: inherit; }
  a[aria-current="page"] { color: var(--blue); }
</style>
