---
import { defaultLanguage, localizedHref, type Language } from '../../i18n/config';
import { siteLocales, siteUi } from '../../i18n/site';

interface Props {
  lang?: Language;
}

const { lang = defaultLanguage } = Astro.props;
const siteConfig = siteLocales[lang];
const ui = siteUi[lang];

const telegramUrl = 'https://t.me/sus_pav';
const linkedinUrl = 'https://www.linkedin.com/in/pavel-suslikov/';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-thesis">
      <p class="footer-eyebrow">{ui.thesis}</p>

      <h2>
        {siteConfig.footerTitle}
      </h2>
    </div>

    <div class="footer-meta">
      <p>
        <strong>{ui.author}</strong>
        <span>{siteConfig.author}</span>
      </p>

      <p>
        <strong>{ui.organization}</strong>
        <span>{siteConfig.organization}</span>
      </p>

      <p>
        <strong>{ui.specialty}</strong>
        <span>{siteConfig.specialty}</span>
      </p>

      <p>
        <strong>{ui.format}</strong>
        <span>{siteConfig.footerFormat}</span>
      </p>
    </div>

    <div class="footer-actions">
      <a class="footer-button footer-button--primary" href={localizedHref('/downloads', lang)}>
        {ui.downloadMaterials}
      </a>

      <a class="footer-button footer-button--secondary" href="mailto:Suslikov.PK@gmail.com">
        {ui.contactAuthor}
      </a>

      <div class="footer-social" aria-label={ui.authorSocials}>
        <a class="footer-social-link" href={telegramUrl} target="_blank" rel="noopener noreferrer" aria-label="Telegram">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.7 4.2 18.5 19.3c-.2 1-.8 1.2-1.6.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.3-.1-.5-.6-.2l-11 6.9-4.7-1.5c-1-.3-1-1 .2-1.5L20.3 3c.8-.3 1.6.2 1.4 1.2z" />
          </svg>
        </a>

        <a class="footer-social-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0zM.5 8h4v15h-4V8zm7.5 0h3.8v2.1h.1c.5-1 1.9-2.4 4-2.4 4.3 0 5.1 2.8 5.1 6.5V23h-4v-7.8c0-1.9 0-4.3-2.6-4.3s-3 2-3 4.1v8H8V8z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 44px 0 52px;
    border-top: 1px solid var(--line);
    background: transparent;
    color: #5f6d7e;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.25fr .95fr .7fr;
    gap: clamp(28px, 5vw, 58px);
    align-items: start;
  }

  .footer-eyebrow {
    margin: 0 0 22px;
    color: #5f687a;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .footer-thesis h2 {
    max-width: 680px;
    margin: 0;
    color: #1f2334;
    font-family: inherit;
    font-size: clamp(1.05rem, 1.45vw, 1.42rem);
    font-style: normal;
    font-weight: 650;
    line-height: 1.42;
    letter-spacing: -.025em;
  }

  .footer-meta {
    padding-top: 2px;
  }

  .footer-meta p {
    margin: 0 0 12px;
    color: #565f73;
    font-size: clamp(.82rem, 1vw, .98rem);
    line-height: 1.45;
  }

  .footer-meta strong {
    color: #202334;
    font-weight: 850;
  }

  .footer-meta span {
    color: #565f73;
  }

  .footer-actions {
    display: grid;
    gap: 14px;
    padding-top: 2px;
  }

  .footer-button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 14px 18px;
    border-radius: 10px;
    font-size: .86rem;
    font-weight: 850;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    transition:
      transform .18s ease,
      box-shadow .18s ease,
      background .18s ease,
      border-color .18s ease;
  }

  .footer-button:hover {
    transform: translateY(-1px);
  }

  .footer-button--primary {
    background: var(--blue);
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(31, 95, 130, .16);
  }

  .footer-button--primary:hover {
    background: #184f6d;
    box-shadow: 0 16px 34px rgba(31, 95, 130, .22);
  }

  .footer-button--secondary {
    border: 1px solid var(--line);
    background: transparent;
    color: #4b4e6d;
    box-shadow: none;
  }

  .footer-button--secondary:hover {
    border-color: rgba(31, 95, 130, .28);
    background: rgba(255, 255, 255, .35);
  }

  .footer-social {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding-top: 4px;
  }

  .footer-social-link {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: transparent;
    color: #4b4e6d;
    text-decoration: none;
    transition:
      transform .18s ease,
      background .18s ease,
      border-color .18s ease,
      color .18s ease;
  }

  .footer-social-link:hover {
    transform: translateY(-1px);
    border-color: rgba(31, 95, 130, .3);
    background: rgba(255, 255, 255, .35);
    color: var(--blue);
  }

  .footer-social-link svg {
    width: 19px;
    height: 19px;
    display: block;
    fill: currentColor;
  }

  @media (max-width: 980px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-actions {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
    }

    .footer-social {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-eyebrow {
      margin-bottom: 16px;
    }

    .footer-actions {
      grid-template-columns: 1fr;
    }

    .footer-button {
      min-height: 48px;
    }

    .footer-social {
      justify-content: center;
    }
  }
</style>
