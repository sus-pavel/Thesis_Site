        items: ['Схема ЭТК', 'Графики нагрузок и ВИЭ', 'Параметры оборудования'],
      },
      cycle: {
        kind: 'Итерационный контур',
        title: 'Расчётный цикл',
        text: 'CC-PSO изменяет параметры DSM, модель пересчитывает режим, а целевая функция определяет следующее направление поиска.',
        items: ['Параметры DSM', 'Моделирование ЭТК', 'Проверка сходимости'],
      },
      results: {
        kind: 'Выход расчёта',
        title: 'Результаты',
        text: 'Сценарии сравниваются по структуре нагрузки, работе генерации, затратам, выбросам и сроку окупаемости.',
        items: ['Профили мощности', 'Структура генерации', 'Экономический эффект'],
      },
    },
  },
};
---

<section class="architecture-explorer" data-architecture-explorer>
  <nav class="scene-rail" aria-label="Сцены архитектуры">
    <span class="scene-rail__label">Сцена</span>

    <button type="button" data-scene="system" aria-pressed="true">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="12" r="2.25"></circle>
        <circle cx="18.5" cy="5" r="2.25"></circle>
        <circle cx="18.5" cy="19" r="2.25"></circle>
        <path d="M7.2 11 16.4 6.2M7.2 13l9.2 4.8"></path>
      </svg>
      <span>Система</span>
    </button>

    <button type="button" data-scene="position1" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="5" cy="7" r="2"></circle>
        <circle cx="12" cy="17" r="2"></circle>
        <circle cx="19" cy="7" r="2"></circle>
        <path d="M6.6 8.2 10.7 15M13.4 15.2 17.6 8.5M7 7h10"></path>
      </svg>
      <span>Положение 1</span>
    </button>

    <button type="button" data-scene="position2" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 17c3.5 0 3.2-5 6.7-5s3.2 5 6.6 5S19.7 12 22 12M3 7h4m3 0h4m3 0h4"></path>
        <circle cx="8.5" cy="7" r="1.5"></circle>
        <circle cx="15.5" cy="7" r="1.5"></circle>
      </svg>
      <span>Положение 2</span>
    </button>
  </nav>

  <div class="canvas-shell">
    <header class="canvas-heading">
      <h1 data-scene-title>Архитектура решения</h1>
      <p data-scene-subtitle>Перемещайтесь по схеме, масштабируйте и открывайте узлы</p>
    </header>

    <div
      class="architecture-viewport"
      data-viewport
      tabindex="0"
      aria-label="Интерактивная схема. Используйте стрелки для перемещения, плюс и минус для масштаба."
    >
      <div class="technical-grid" aria-hidden="true"></div>
      <div class="orbit orbit--one" aria-hidden="true"></div>
      <div class="orbit orbit--two" aria-hidden="true"></div>

      <div class="pan-layer" data-layer>
        <SystemScene />
        <PositionOneScene />
        <PositionTwoScene />
      </div>
    </div>

    <aside class="detail-panel" data-detail-panel aria-live="polite">
      <button class="detail-panel__close" type="button" data-panel-close aria-label="Закрыть описание">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>

      <p class="detail-panel__kind" data-detail-kind></p>
      <h2 data-detail-title></h2>
      <div class="detail-panel__formula" data-detail-formula hidden></div>
      <p class="detail-panel__text" data-detail-text></p>
      <ul data-detail-items></ul>
      <dl class="detail-panel__terms" data-detail-terms hidden></dl>
    </aside>

    <p class="interaction-hint">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8.5 11V6.8a1.7 1.7 0 0 1 3.4 0V10m0-3.7a1.7 1.7 0 0 1 3.4 0V10m0-2a1.7 1.7 0 0 1 3.4 0v5.4c0 5.1-2.7 7.6-7.4 7.6-2.2 0-3.8-.8-5.1-2.4L3.7 15a1.6 1.6 0 0 1 2.4-2.1l2.4 2.4V8.5a1.7 1.7 0 0 1 3.4 0"></path>
      </svg>
      <span>Перетаскивайте для перемещения</span>
      <i>·</i>
      <span>Колесо мыши для масштабирования</span>
      <i>·</i>
      <span>Нажмите на блок или формулу для пояснения</span>
    </p>

    <div class="zoom-controls" aria-label="Масштаб схемы">
      <button type="button" data-zoom-out aria-label="Уменьшить масштаб">−</button>
      <button type="button" data-zoom-in aria-label="Увеличить масштаб">+</button>
      <button type="button" data-reset aria-label="Вернуть начальный вид">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 11a8 8 0 1 0 2.3-5.7L4 7.6M4 3v4.6h4.6"></path>
        </svg>
      </button>
      <button type="button" data-fit aria-label="Показать всю схему">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 3H3v5m13-5h5v5M8 21H3v-5m13 5h5v-5"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
    </div>
  </div>

  <script is:inline id="architecture-scene-data" type="application/json" set:html={JSON.stringify(scenes)}></script>
</section>

<script is:inline>
  (() => {
    const dataNode = document.querySelector('#architecture-scene-data');
    if (!dataNode) return;
    const sceneData = JSON.parse(dataNode.textContent);

    document.querySelectorAll('[data-architecture-explorer]').forEach((explorer) => {
      const viewport = explorer.querySelector('[data-viewport]');
      const layer = explorer.querySelector('[data-layer]');
      const sceneTitle = explorer.querySelector('[data-scene-title]');
      const sceneSubtitle = explorer.querySelector('[data-scene-subtitle]');
      const panel = explorer.querySelector('[data-detail-panel]');
      const panelKind = explorer.querySelector('[data-detail-kind]');
      const panelTitle = explorer.querySelector('[data-detail-title]');
      const panelFormula = explorer.querySelector('[data-detail-formula]');
      const panelText = explorer.querySelector('[data-detail-text]');
      const panelItems = explorer.querySelector('[data-detail-items]');
      const panelTerms = explorer.querySelector('[data-detail-terms]');
      const sceneButtons = [...explorer.querySelectorAll('[data-scene]')];
      const surfaces = [...explorer.querySelectorAll('[data-scene-surface]')];

      let activeSceneKey = 'system';
      let scale = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let pointerId = null;
      let startX = 0;
      let startY = 0;
      let originX = 0;
      let originY = 0;
      let initialScale = 1;
      let initialPanX = 0;
      let initialPanY = 0;

      const getMinScale = () => activeSceneKey === 'position1' ? .86 : .48;

      const constrainPan = () => {
        const scene = sceneData[activeSceneKey];
        const scaledWidth = scene.width * scale;
        const scaledHeight = scene.height * scale;
        const minimumVisibleWidth = Math.min(scaledWidth, Math.max(220, viewport.clientWidth * .46));
        const minimumVisibleHeight = Math.min(scaledHeight, Math.max(170, viewport.clientHeight * .42));
        const maxPanX = Math.max(0, (viewport.clientWidth + scaledWidth) / 2 - minimumVisibleWidth);
        const maxPanY = Math.max(0, (viewport.clientHeight + scaledHeight) / 2 - minimumVisibleHeight);
        panX = Math.min(Math.max(panX, -maxPanX), maxPanX);
        panY = Math.min(Math.max(panY, -maxPanY), maxPanY);
      };

      const applyTransform = () => {
        constrainPan();
        layer.style.setProperty('--scene-scale', scale);
        layer.style.transform = `translate(-50%, -50%) translate(${panX}px, ${panY}px) scale(${scale})`;
      };

      const fitScene = (focus = false) => {
        const scene = sceneData[activeSceneKey];
        const compact = window.matchMedia('(max-width: 700px)').matches;
        const gutter = compact ? 28 : 64;
        const naturalFit = Math.min(
          (viewport.clientWidth - gutter) / scene.width,
          (viewport.clientHeight - gutter) / scene.height,
          1
        );

        scale = Math.max(naturalFit, getMinScale());
        panX = 0;
        panY = 0;

        if (focus) {
          const scaledWidth = scene.width * scale;
          const scaledHeight = scene.height * scale;

          if (scaledWidth > viewport.clientWidth - 32) {
            const desiredLeft = compact ? 20 : 32;
            panX = desiredLeft + scaledWidth / 2 - viewport.clientWidth / 2;
          }

          if (activeSceneKey === 'position1') {
            const desiredTop = compact ? 142 : 48;
            panY = desiredTop + scaledHeight / 2 - viewport.clientHeight / 2;
          } else {
            panY = compact ? 54 : activeSceneKey === 'position2' ? 80 : 72;
          }

          initialScale = scale;
          initialPanX = panX;
          initialPanY = panY;
        }

        applyTransform();
      };

      const clearSelection = () => {
        explorer.querySelectorAll('.diagram-node.is-selected, .diagram-node.is-related, .diagram-node.is-muted, .formula-button.is-selected, .route-path.is-selected, .route-path.is-emphasized, .route-path.is-muted, .route-label.is-selected, .route-label.is-emphasized').forEach((element) => {
          element.classList.remove('is-selected', 'is-related', 'is-muted', 'is-emphasized');
        });
      };

      const highlightNodeConnections = (nodeId) => {
        const activeSurface = explorer.querySelector(`[data-scene-surface="${activeSceneKey}"]`);
        const routes = [...activeSurface.querySelectorAll('.route-path')];
        if (!routes.length || !nodeId) return;

        const connectedRoutes = routes.filter((route) => route.dataset.connects?.split(' ').includes(nodeId));
        if (!connectedRoutes.length) return;

        const relatedNodeIds = new Set([nodeId]);
        connectedRoutes.forEach((route) => {
          route.classList.add('is-emphasized');
          route.dataset.connects.split(' ').forEach((id) => relatedNodeIds.add(id));
          activeSurface.querySelector(`[data-route-for="${route.dataset.routeId}"]`)?.classList.add('is-emphasized');
        });
        routes.filter((route) => !connectedRoutes.includes(route)).forEach((route) => route.classList.add('is-muted'));

        activeSurface.querySelectorAll('[data-node-id]').forEach((node) => {
          if (node.dataset.nodeId !== nodeId && relatedNodeIds.has(node.dataset.nodeId)) node.classList.add('is-related');
          if (!relatedNodeIds.has(node.dataset.nodeId)) node.classList.add('is-muted');
        });
      };

      const selectTrigger = (trigger) => {
        clearSelection();
        const node = trigger.closest('.diagram-node');
        if (node) node.classList.add('is-selected');
        if (trigger.classList.contains('formula-button')) trigger.classList.add('is-selected');
        highlightNodeConnections(node?.dataset.nodeId ?? trigger.dataset.detailId);
      };

      const setPanel = (detailId, trigger) => {
        const detail = sceneData[activeSceneKey].details[detailId];
        if (!detail) return;

        panel.classList.remove('is-hidden');
        panelKind.textContent = detail.kind;
        panelTitle.textContent = detail.title;
        panelText.textContent = detail.text;

        panelFormula.replaceChildren();
        if (detail.formulaAsset) {
          const formulaImage = document.createElement('img');
          formulaImage.src = detail.formulaAsset;
          formulaImage.alt = detail.formula ?? '';
          panelFormula.append(formulaImage);
          panelFormula.hidden = false;
        } else if (detail.formula) {
          panelFormula.textContent = detail.formula;
          panelFormula.hidden = false;
        } else {
          panelFormula.hidden = true;
        }

        const items = detail.items ?? [];
        panelItems.replaceChildren(...items.map((item) => {
          const li = document.createElement('li');
          li.textContent = item;
          return li;
        }));
        panelItems.hidden = items.length === 0;

        const terms = detail.terms ?? [];
        const termNodes = [];
        terms.forEach((term) => {
          const dt = document.createElement('dt');
          const dd = document.createElement('dd');
          dt.textContent = term.symbol;
          dd.textContent = term.description;
          termNodes.push(dt, dd);
        });
        panelTerms.replaceChildren(...termNodes);
        panelTerms.hidden = terms.length === 0;

        if (trigger) selectTrigger(trigger);
      };

      const activateDefaultDetail = () => {
        clearSelection();
        panel.classList.add('is-hidden');
      };

      const setScene = (key, focus = false) => {
        const scene = sceneData[key];
        activeSceneKey = key;
        sceneTitle.textContent = scene.title;
        sceneSubtitle.textContent = scene.subtitle;
        layer.style.width = `${scene.width}px`;
        layer.style.height = `${scene.height}px`;
        explorer.dataset.activeScene = key;

        sceneButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.scene === key));
        });
        surfaces.forEach((surface) => {
          surface.classList.toggle('is-active', surface.dataset.sceneSurface === key);
        });

        activateDefaultDetail();
        requestAnimationFrame(() => fitScene(focus));
      };

      const zoomTo = (nextScale, clientX, clientY) => {
        const previousScale = scale;
        scale = Math.min(Math.max(nextScale, getMinScale()), 2.4);

        if (Number.isFinite(clientX) && Number.isFinite(clientY) && scale !== previousScale) {
          const bounds = viewport.getBoundingClientRect();
          const pointerX = clientX - bounds.left - bounds.width / 2;
          const pointerY = clientY - bounds.top - bounds.height / 2;
          const ratio = scale / previousScale;
          panX = pointerX - (pointerX - panX) * ratio;
          panY = pointerY - (pointerY - panY) * ratio;
        }

        applyTransform();
      };

      const zoomBy = (factor, clientX, clientY) => zoomTo(scale * factor, clientX, clientY);

      const selectRoute = (route) => {
        clearSelection();
        const activeSurface = explorer.querySelector(`[data-scene-surface="${activeSceneKey}"]`);
        const connectedIds = route.dataset.connects?.split(' ') ?? [];
        route.classList.add('is-selected');
        activeSurface.querySelector(`[data-route-for="${route.dataset.routeId}"]`)?.classList.add('is-selected');
        activeSurface.querySelectorAll('.route-path').forEach((candidate) => {
          if (candidate !== route) candidate.classList.add('is-muted');
        });
        activeSurface.querySelectorAll('[data-node-id]').forEach((node) => {
          node.classList.toggle('is-related', connectedIds.includes(node.dataset.nodeId));
          node.classList.toggle('is-muted', !connectedIds.includes(node.dataset.nodeId));
        });
      };

      explorer.querySelectorAll('[data-detail-id]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.stopPropagation();
          setPanel(trigger.dataset.detailId, trigger);
        });
      });

      sceneButtons.forEach((button) => {
        button.addEventListener('click', () => setScene(button.dataset.scene, true));
      });

      explorer.querySelector('[data-zoom-in]').addEventListener('click', () => zoomBy(1.16));
      explorer.querySelector('[data-zoom-out]').addEventListener('click', () => zoomBy(.86));
      explorer.querySelector('[data-reset]').addEventListener('click', () => {
        scale = initialScale;
        panX = initialPanX;
        panY = initialPanY;
        applyTransform();
      });
      explorer.querySelector('[data-fit]').addEventListener('click', () => fitScene(false));
      explorer.querySelector('[data-panel-close]').addEventListener('click', () => panel.classList.add('is-hidden'));

      viewport.addEventListener('wheel', (event) => {
        event.preventDefault();
        zoomBy(event.deltaY < 0 ? 1.09 : .91, event.clientX, event.clientY);
      }, { passive: false });

      explorer.querySelectorAll('.route-path').forEach((route) => {
        const label = explorer.querySelector(`[data-route-for="${route.dataset.routeId}"]`);
        const hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        hitArea.setAttribute('d', route.getAttribute('d'));
        hitArea.classList.add('route-hit');
        hitArea.dataset.routeHit = route.dataset.routeId;
        route.before(hitArea);

        [route, hitArea].forEach((target) => {
          target.addEventListener('pointerenter', () => {
            route.classList.add('is-emphasized');
            label?.classList.add('is-emphasized');
          });
          target.addEventListener('pointerleave', () => {
            if (!route.classList.contains('is-selected')) {
              route.classList.remove('is-emphasized');
              label?.classList.remove('is-emphasized');
            }
          });
          target.addEventListener('click', (event) => {
            event.stopPropagation();
            selectRoute(route);
          });
        });
        route.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          selectRoute(route);
        });
      });

      viewport.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button')) return;
        dragging = true;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        originX = panX;
        originY = panY;
        viewport.setPointerCapture(pointerId);
        viewport.classList.add('is-dragging');
      });

      viewport.addEventListener('pointermove', (event) => {
        if (!dragging || event.pointerId !== pointerId) return;
        panX = originX + event.clientX - startX;
        panY = originY + event.clientY - startY;
        applyTransform();
      });

      const endDrag = (event) => {
        if (!dragging || event.pointerId !== pointerId) return;
        dragging = false;
        viewport.classList.remove('is-dragging');
        if (viewport.hasPointerCapture(pointerId)) viewport.releasePointerCapture(pointerId);
        pointerId = null;
      };

      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      viewport.addEventListener('keydown', (event) => {
        const distance = event.shiftKey ? 80 : 34;
        if (event.key === 'ArrowLeft') panX -= distance;
        else if (event.key === 'ArrowRight') panX += distance;
        else if (event.key === 'ArrowUp') panY -= distance;
        else if (event.key === 'ArrowDown') panY += distance;
        else if (event.key === '+' || event.key === '=') zoomBy(1.15);
        else if (event.key === '-') zoomBy(.86);
        else if (event.key === '0') fitScene(false);
        else return;
        event.preventDefault();
        applyTransform();
      });

      window.addEventListener('resize', () => fitScene(true));
      setScene('system', true);
    });
  })();
</script>

<style>
  .architecture-explorer {
    --canvas: #ffffff;
    --canvas-deep: #f8fafd;
    --canvas-line: rgba(47, 115, 217, .09);
    --canvas-text: #0b1f3a;
    display: grid;
    grid-template-columns: 152px minmax(0, 1fr);
    min-height: calc(100svh - 64px);
    overflow: hidden;
    background: #f7f9fc;
  }

  .scene-rail {
    position: relative;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 38px 10px 18px;
    border-right: 1px solid #d9e1e8;
    background: #f7f9fc;
  }

  .scene-rail__label {
    margin: 0 10px 8px;
    color: #6c7889;
    font-size: .68rem;
    font-weight: 750;
  }

  .scene-rail button {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 52px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #526072;
    background: transparent;
    font-size: .72rem;
    font-weight: 720;
    line-height: 1.2;
    text-align: left;
    transition: color .2s ease, border-color .2s ease, background .2s ease;
  }

  .scene-rail button:hover {
    color: var(--ink);
    background: rgba(255, 255, 255, .72);
  }

  .scene-rail button[aria-pressed="true"] {
    border-color: rgba(24, 86, 216, .48);
    color: var(--blue);
    background: rgba(255, 255, 255, .9);
    box-shadow: 0 7px 24px rgba(41, 70, 103, .06);
  }

  .scene-rail svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.25;
  }

  .canvas-shell {
    position: relative;
    min-width: 0;
    min-height: calc(100svh - 64px);
    overflow: hidden;
    color: var(--canvas-text);
    background: var(--canvas);
  }

  .canvas-heading {
    position: absolute;
    top: clamp(24px, 4vw, 42px);
    left: clamp(22px, 3vw, 42px);
    z-index: 5;
    max-width: min(680px, calc(100% - 390px));
    pointer-events: none;
  }

  .canvas-heading h1 {
    margin: 0;
    color: #0b1f3a;
    font-size: clamp(1.65rem, 3vw, 2.65rem);
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  [data-active-scene="position2"] .canvas-heading h1 {
    color: #ff835f;
  }

  .canvas-heading p {
    max-width: 620px;
    margin: 10px 0 0;
    color: #61758b;
    font-size: clamp(.78rem, 1.1vw, .98rem);
    line-height: 1.45;
  }

  .architecture-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
  }

  .architecture-viewport:focus-visible {
    outline: 2px solid #67aef4;
    outline-offset: -5px;
  }

  .architecture-viewport.is-dragging {
    cursor: grabbing;
  }

  .technical-grid {
    position: absolute;
    inset: 0;
    opacity: .36;
    background-image:
      linear-gradient(var(--canvas-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--canvas-line) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at center, black 18%, transparent 82%);
  }

  .orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px dashed rgba(47, 115, 217, .12);
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .orbit--one { width: min(62vw, 820px); aspect-ratio: 1; opacity: .55; }
  .orbit--two { width: min(91vw, 1240px); aspect-ratio: 1; opacity: .42; }

  .pan-layer {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: center;
    will-change: transform;
  }

  .pan-layer::after {
    content: "";
    position: absolute;
    inset: -2%;
    z-index: -1;
    border-radius: 24px;
    box-shadow: 0 0 90px rgba(47, 115, 217, .035);
    pointer-events: none;
  }

  .architecture-explorer :global(.diagram-surface) {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    color: #0b1f3a;
  }

  .architecture-explorer :global(.diagram-surface.is-active) { display: block; }

  .architecture-explorer :global(.connection-map) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
