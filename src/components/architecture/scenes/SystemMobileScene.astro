---
import type { Language } from '../../../i18n/config';

interface Props {
  lang?: Language;
}

const { lang = 'ru' } = Astro.props;
const tr = (ru: string, en: string) => lang === 'en' ? en : ru;
---

<div class="system-mobile-surface" aria-label={tr('Архитектура системы DSM в последовательном представлении', 'DSM system architecture in a sequential view')}>
  <section class="mobile-zone mobile-zone--physical" aria-labelledby="mobile-physical-title">
    <p class="mobile-zone__eyebrow">{tr('Уровень 01', 'Level 01')}</p>
    <h2 id="mobile-physical-title">{tr('Физический уровень', 'Physical Layer')}</h2>
    <p class="mobile-zone__intro">{tr('Полная топология автономного электротехнического комплекса', 'Complete topology of the isolated power system')}</p>

    <div class="mobile-physical-flow">
      <button type="button" data-detail-id="generator">
        <small>{tr('Источник', 'Source')}</small>
        <strong>{tr('Генерация ЭЭ', 'Electricity Generation')}</strong>
        <span>{tr('0,4 кВ · прибор учёта', '0.4 kV · electricity meter')}</span>
      </button>
      <i aria-hidden="true">↓</i>
      <button type="button" data-detail-id="transformer">
        <small>{tr('Автономный ЭТК', 'Isolated Power System')}</small>
        <strong>{tr('Трансформатор T1', 'Transformer T1')}</strong>
        <span>{tr('Переход на шину 6 кВ', 'Connection to the 6 kV bus')}</span>
      </button>
      <i aria-hidden="true">↓</i>
      <button type="button" data-detail-id="bus">
        <small>{tr('Распределение', 'Distribution')}</small>
        <strong>{tr('Шина 6 кВ', '6 kV Bus')}</strong>
        <span>T2 · T3 · Tn</span>
      </button>
      <i aria-hidden="true">↓</i>
      <button type="button" data-detail-id="load">
        <small>{tr('Потребление', 'Consumption')}</small>
        <strong>{tr('Нагрузка 0,4 кВ', '0.4 kV Loads')}</strong>
        <span>{tr('Приборы учёта и состояния', 'Electricity meters and states')}</span>
      </button>
    </div>

    <button class="mobile-context" type="button" data-detail-id="external">
      <span>
        <small>{tr('Контекст режима', 'Operating Context')}</small>
        <strong>{tr('Техпроцесс, погода и обслуживание', 'Process, weather, and maintenance')}</strong>
      </span>
      <b>{tr('Подробнее →', 'Details →')}</b>
    </button>
  </section>

  <div class="mobile-data-bus" aria-label={tr('Потоки данных', 'Data Flows')}>
    <strong>{tr('Потоки данных', 'Data Flows')}</strong>
    <span>{tr('Телеметрия · параметры · контекст', 'Telemetry · parameters · context')}</span>
  </div>

  <section class="mobile-zone mobile-zone--data" aria-labelledby="mobile-data-title">
    <p class="mobile-zone__eyebrow">{tr('Уровень 02', 'Level 02')}</p>
    <h2 id="mobile-data-title">{tr('Центр обработки данных', 'Data Centre')}</h2>
    <p class="mobile-zone__intro">{tr('Выберите этап, чтобы открыть подробное описание', 'Select a stage to open its detailed description')}</p>

    <div class="mobile-timeline">
      <button type="button" data-detail-id="monitoring">
        <span class="mobile-step">01</span>
        <span>
          <small>{tr('Наблюдение', 'Monitoring')}</small>
          <strong>{tr('Мониторинг классов нагрузок', 'Load-Class Monitoring')}</strong>
          <em>{tr('Классификация состояний и p(ON)(t)', 'State classification and p(ON)(t)')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="load-data">
        <span class="mobile-step">DB</span>
        <span>
          <small>{tr('Хранение', 'Storage')}</small>
          <strong>{tr('Единая база данных', 'Unified Database')}</strong>
          <em>{tr('Электротехнические и технологические параметры', 'Electrical and process parameters')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="forecast">
        <span class="mobile-step mobile-step--coral">02</span>
        <span>
          <small>{tr('Прогноз', 'Forecast')}</small>
          <strong>{tr('Прогноз временных рядов', 'Time-Series Forecasting')}</strong>
          <em>{tr('24 часа · дискретность 1 минута', '24 hours · 1-minute resolution')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="decomposition">
        <span class="mobile-step mobile-step--coral">05</span>
        <span>
          <small>{tr('Анализ', 'Analysis')}</small>
          <strong>{tr('Сингулярное разложение', 'Singular Spectrum Analysis')}</strong>
          <em>{tr('Компоненты · паттерны · DR PI · DR FI', 'Components · patterns · DR PI · DR FI')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="modeling">
        <span class="mobile-step">04</span>
        <span>
          <small>{tr('Расчёт режима', 'System Calculation')}</small>
          <strong>{tr('Моделирование ЭТК', 'Power-System Modelling')}</strong>
          <em>MOST · MPC · transmat · xgd · sd</em>
        </span>
      </button>

      <button type="button" data-detail-id="optimization">
        <span class="mobile-step mobile-step--coral">03</span>
        <span>
          <small>{tr('Оптимизация', 'Optimisation')}</small>
          <strong>{tr('Параметры DSM методом CC-PSO', 'DSM Parameters using CC-PSO')}</strong>
          <em>{tr('Итерационный процесс · 6 этапов', 'Iterative process · 6 stages')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="criterion">
        <span class="mobile-step mobile-step--decision">?</span>
        <span>
          <small>{tr('Решение', 'Decision')}</small>
          <strong>{tr('Критерий применения DSM', 'DSM Application Criterion')}</strong>
          <em>{tr('OPEX и среднесуточный DR FI', 'OPEX and mean daily DR FI')}</em>
        </span>
      </button>

      <button type="button" data-detail-id="control">
        <span class="mobile-step mobile-step--control">↺</span>
        <span>
          <small>{tr('Обратная связь', 'Feedback')}</small>
          <strong>{tr('Управление нагрузкой', 'Load Control')}</strong>
          <em>{tr('Сигналы DSM возвращаются на физический уровень', 'DSM signals return to the physical layer')}</em>
        </span>
      </button>
    </div>
  </section>
</div>

<style>
  .system-mobile-surface {
    display: none;
  }

  @media (max-width: 700px) {
    .system-mobile-surface {
      position: relative;
      display: none;
      min-height: 100%;
      padding: 142px 14px 72px;
      color: #0b1f3a;
    }

    :global([data-active-scene="system"]) .system-mobile-surface {
      display: block;
    }

    .mobile-zone {
      padding: 20px 16px;
      border: 1px solid rgba(47, 115, 217, .25);
      border-radius: 18px;
      background: rgba(255, 255, 255, .82);
      box-shadow: 0 12px 34px rgba(34, 72, 112, .07);
    }

    .mobile-zone--physical {
      border-color: rgba(222, 104, 79, .32);
    }

    .mobile-zone__eyebrow {
      margin: 0 0 5px;
      color: #2f73d9;
      font-size: .68rem;
      font-weight: 850;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .mobile-zone h2 {
      margin: 0;
      font-size: 1.22rem;
      line-height: 1.15;
      letter-spacing: -.025em;
    }

    .mobile-zone__intro {
      margin: 7px 0 18px;
      color: #52677b;
      font-size: .78rem;
      line-height: 1.45;
    }

    .mobile-physical-flow {
      display: grid;
      gap: 8px;
    }

    .mobile-physical-flow > i {
      color: #2f73d9;
      font-size: 1rem;
      font-style: normal;
      line-height: 1;
      text-align: center;
    }

    .mobile-physical-flow button,
    .mobile-timeline button,
    .mobile-context {
      min-height: 52px;
      border: 1px solid rgba(47, 115, 217, .2);
      color: inherit;
      background: #ffffff;
      text-align: left;
    }

    .mobile-physical-flow button {
      display: grid;
      gap: 4px;
      padding: 13px 14px;
      border-radius: 12px;
    }

    .mobile-physical-flow small,
    .mobile-timeline small,
    .mobile-context small {
      color: #2f73d9;
      font-size: .65rem;
      font-weight: 820;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .mobile-physical-flow strong,
    .mobile-timeline strong,
    .mobile-context strong {
      font-size: .9rem;
      line-height: 1.28;
    }

    .mobile-physical-flow span,
    .mobile-context b {
      color: #5a6e81;
      font-size: .72rem;
      font-weight: 620;
      line-height: 1.35;
    }

    .mobile-context {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      width: 100%;
      margin-top: 16px;
      padding: 14px;
      border-color: rgba(222, 104, 79, .24);
      border-radius: 12px;
    }

    .mobile-context > span {
      display: grid;
      gap: 4px;
    }

    .mobile-context b {
      flex: 0 0 auto;
      color: #2f73d9;
    }

    .mobile-data-bus {
      display: grid;
      gap: 3px;
      margin: 14px 20px;
      padding: 12px 16px;
      border-radius: 12px;
      color: #ffffff;
      background: #2f73d9;
      text-align: center;
    }

    .mobile-data-bus strong {
      font-size: .76rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .mobile-data-bus span {
      font-size: .66rem;
      opacity: .84;
    }

    .mobile-timeline {
      position: relative;
      display: grid;
      gap: 12px;
    }

    .mobile-timeline::before {
      content: "";
      position: absolute;
      top: 30px;
      bottom: 30px;
      left: 30px;
      width: 1px;
      background: rgba(47, 115, 217, .22);
    }

    .mobile-timeline button {
      position: relative;
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 12px;
      align-items: start;
      padding: 14px;
      border-radius: 13px;
      box-shadow: 0 7px 20px rgba(34, 72, 112, .05);
    }

    .mobile-timeline button > span:last-child {
      display: grid;
      gap: 4px;
      min-width: 0;
    }

    .mobile-timeline em {
      color: #5a6e81;
      font-size: .72rem;
      font-style: normal;
      line-height: 1.4;
    }

    .mobile-step {
      position: relative;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border: 1px solid rgba(47, 115, 217, .32);
      border-radius: 50%;
      color: #2f73d9;
      background: #f2f7fd;
      font-size: .68rem;
      font-weight: 850;
    }

    .mobile-step--coral,
    .mobile-step--decision {
      border-color: rgba(222, 104, 79, .38);
      color: #b44d38;
      background: #fff6f3;
    }

    .mobile-step--control {
      border-color: rgba(73, 61, 136, .36);
      color: #493d88;
      background: #f5f3fb;
    }

    .mobile-physical-flow button:hover,
    .mobile-physical-flow button:focus-visible,
    .mobile-context:hover,
    .mobile-context:focus-visible,
    .mobile-timeline button:hover,
    .mobile-timeline button:focus-visible {
      border-color: #2f73d9;
      outline: 3px solid rgba(47, 115, 217, .12);
      outline-offset: 1px;
    }
  }
</style>
