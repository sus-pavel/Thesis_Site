---
import type { Language } from '../../../i18n/config';

interface Props {
  lang?: Language;
}

const { lang = 'ru' } = Astro.props;
const tr = (ru: string, en: string) => lang === 'en' ? en : ru;
---

<div
  class="diagram-surface system-surface is-active"
  data-scene-surface="system"
  aria-label={tr('Архитектура системы DSM с учётом классификации нагрузок', 'DSM system architecture with load classification')}
>
  <svg class="system-map" viewBox="0 0 1680 2500" role="img" aria-labelledby="system-map-title system-map-description">
    <title id="system-map-title">{tr('Архитектура системы DSM с учётом классификации нагрузок', 'DSM system architecture with load classification')}</title>
    <desc id="system-map-description">
      {tr(
        'Физический уровень автономного электротехнического комплекса связан с центром обработки данных, мониторингом, прогнозированием, моделированием, сингулярным разложением и оптимизацией CC-PSO.',
        'The physical layer of the isolated power system is connected to the data centre, monitoring, forecasting, modelling, singular spectrum analysis, and CC-PSO optimisation.',
      )}
    </desc>

    <defs>
      <marker id="system-arrow-blue" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10Z"></path>
      </marker>
      <marker id="system-arrow-coral" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10Z"></path>
      </marker>
      <marker id="system-arrow-control" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10Z"></path>
      </marker>
      <marker id="system-arrow-ink" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10Z"></path>
      </marker>
      <linearGradient id="system-card-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#f4f8fc"></stop>
      </linearGradient>
      <linearGradient id="system-card-fill-coral" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#fff7f4"></stop>
      </linearGradient>
    </defs>

    <g class="system-level system-level--physical">
      <rect class="level-frame" x="40" y="120" width="1600" height="366" rx="40"></rect>
      <rect class="level-title-backdrop" x="660" y="94" width="360" height="58" rx="29"></rect>
      <text class="level-title" x="840" y="134">{tr('Физический уровень', 'Physical Layer')}</text>

      <g
        class="physical-node physical-node--generation"
        data-detail-id="generator"
        data-node-id="generator"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание генерации электроэнергии', 'Open electricity-generation details')}
      >
        <rect class="physical-hit" x="68" y="150" width="315" height="318" rx="20"></rect>
        <text class="network-label network-label--plain" x="88" y="217">Gen 1</text>
        <circle class="network-line" cx="184" cy="209" r="35"></circle>
        <path class="network-line" d="M165 209c7-14 14-14 21 0s14 14 21 0"></path>
        <line class="network-line" x1="219" y1="209" x2="355" y2="209"></line>
        <line class="network-line" x1="355" y1="175" x2="355" y2="446"></line>

        <line class="network-line" x1="266" y1="185" x2="338" y2="185"></line>
        <line class="network-line" x1="266" y1="209" x2="338" y2="209"></line>
        <line class="network-line" x1="266" y1="233" x2="338" y2="233"></line>
        <path class="meter-coil" d="M280 185c0 14 22 14 22 0m0 0c0 14 22 14 22 0"></path>
        <path class="meter-coil" d="M280 209c0 14 22 14 22 0m0 0c0 14 22 14 22 0"></path>
        <path class="meter-coil" d="M280 233c0 14 22 14 22 0m0 0c0 14 22 14 22 0"></path>
        <rect class="meter-box meter-box--solid" x="283" y="258" width="38" height="50"></rect>
        <line class="meter-divider" x1="283" y1="274" x2="321" y2="274"></line>
        <text class="meter-text" x="302" y="297">Wh</text>
        <text class="network-muted" x="367" y="185">{tr('0,4 kV', '0.4 kV')}</text>
        <text class="network-ellipsis" x="184" y="376">…</text>
        <text class="network-block-title" x="100" y="453">{tr('Генерация ЭЭ', 'Generation')}</text>
      </g>

      <g
        class="physical-node physical-node--transformer"
        data-detail-id="transformer"
        data-node-id="transformer"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание трансформаторов автономного ЭТК', 'Open isolated power-system transformer details')}
      >
        <rect class="physical-hit" x="376" y="150" width="298" height="318" rx="20"></rect>
        <text class="network-zone-title" x="500" y="265">{tr('Автономный ЭТК', 'Isolated Power System')}</text>
        <text class="network-label network-label--plain" x="446" y="330">T1</text>
        <line class="network-line" x1="355" y1="381" x2="403" y2="381"></line>
        <circle class="network-line" cx="438" cy="381" r="35"></circle>
        <circle class="network-line" cx="478" cy="381" r="35"></circle>
        <line class="network-line" x1="513" y1="381" x2="672" y2="381"></line>
        <line class="network-line" x1="566" y1="347" x2="566" y2="415"></line>
        <path class="network-arrowhead" d="M584 370l22 11-22 11Z"></path>
        <path class="network-arrowhead" d="M650 370l-22 11 22 11Z"></path>
      </g>

      <g
        class="physical-node physical-node--bus"
        data-detail-id="bus"
        data-node-id="bus"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание шины 6 киловольт', 'Open 6 kV bus details')}
      >
        <rect class="physical-hit" x="670" y="150" width="240" height="318" rx="20"></rect>
        <text class="network-muted" x="616" y="187">6 kV</text>
        <line class="network-line" x1="672" y1="175" x2="672" y2="446"></line>
        <line class="network-line" x1="672" y1="199" x2="907" y2="199"></line>
        <line class="network-line" x1="672" y1="313" x2="907" y2="313"></line>
        <line class="network-line" x1="672" y1="427" x2="907" y2="427"></line>
        <path class="network-arrowhead" d="M699 188l22 11-22 11Z"></path>
        <path class="network-arrowhead" d="M851 188l-22 11 22 11Z"></path>
        <path class="network-arrowhead" d="M699 302l22 11-22 11Z"></path>
        <path class="network-arrowhead" d="M851 302l-22 11 22 11Z"></path>
        <path class="network-arrowhead" d="M699 416l22 11-22 11Z"></path>
        <path class="network-arrowhead" d="M851 416l-22 11 22 11Z"></path>
        <text class="network-muted" x="853" y="187">6 kV</text>
      </g>

      <g
        class="physical-node physical-node--distribution"
        data-detail-id="transformer"
        data-node-id="distribution"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание трансформаторов T2, T3 и Tn', 'Open T2, T3, and Tn transformer details')}
      >
        <rect class="physical-hit" x="906" y="150" width="176" height="318" rx="20"></rect>
        <line class="network-line" x1="907" y1="164" x2="907" y2="234"></line>
        <line class="network-line" x1="907" y1="278" x2="907" y2="348"></line>
        <line class="network-line" x1="907" y1="392" x2="907" y2="462"></line>
        <circle class="network-line" cx="972" cy="199" r="35"></circle>
        <circle class="network-line" cx="1012" cy="199" r="35"></circle>
        <circle class="network-line" cx="972" cy="313" r="35"></circle>
        <circle class="network-line" cx="1012" cy="313" r="35"></circle>
        <circle class="network-line" cx="972" cy="427" r="35"></circle>
        <circle class="network-line" cx="1012" cy="427" r="35"></circle>
        <text class="network-label network-label--plain network-label--centered" x="992" y="159">T2</text>
        <text class="network-label network-label--plain network-label--centered" x="992" y="273">T3</text>
        <text class="network-label network-label--plain network-label--centered" x="992" y="387">
          T<tspan baseline-shift="sub" font-size="15">n</tspan>
        </text>
        <line class="network-line" x1="1047" y1="199" x2="1080" y2="199"></line>
        <line class="network-line" x1="1047" y1="313" x2="1080" y2="313"></line>
        <line class="network-line" x1="1047" y1="427" x2="1080" y2="427"></line>
        <text class="network-ellipsis" x="907" y="376">…</text>
      </g>

      <g
        class="physical-node physical-node--load"
        data-detail-id="load"
        data-node-id="load"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание нагрузки и приборов учёта', 'Open load and electricity-meter details')}
      >
        <rect class="physical-hit" x="1078" y="150" width="224" height="318" rx="20"></rect>
        <line class="network-line" x1="1080" y1="149" x2="1080" y2="252"></line>
        <line class="network-line" x1="1080" y1="278" x2="1080" y2="348"></line>
        <line class="network-line" x1="1080" y1="392" x2="1080" y2="462"></line>
        <path class="network-arrow network-arrow--ink" d="M1080 199h68" marker-end="url(#system-arrow-ink)"></path>
        <path class="network-arrow network-arrow--ink" d="M1080 223h68" marker-end="url(#system-arrow-ink)"></path>
        <path class="network-arrow network-arrow--ink" d="M1080 296h80" marker-end="url(#system-arrow-ink)"></path>
        <path class="network-arrow network-arrow--ink" d="M1080 410h80" marker-end="url(#system-arrow-ink)"></path>

        <line class="network-line" x1="1174" y1="149" x2="1174" y2="204"></line>
        <line class="network-line" x1="1174" y1="161" x2="1230" y2="161"></line>
        <line class="network-line" x1="1174" y1="177" x2="1230" y2="177"></line>
        <line class="network-line" x1="1174" y1="193" x2="1230" y2="193"></line>
        <path class="meter-coil" d="M1184 161c0 13 19 13 19 0m0 0c0 13 19 13 19 0"></path>
        <path class="meter-coil" d="M1184 177c0 13 19 13 19 0m0 0c0 13 19 13 19 0"></path>
        <path class="meter-coil" d="M1184 193c0 13 19 13 19 0m0 0c0 13 19 13 19 0"></path>
        <line class="network-line" x1="1230" y1="177" x2="1237" y2="177"></line>
        <circle class="network-line" cx="1258" cy="177" r="23"></circle>
        <circle class="network-line" cx="1258" cy="177" r="14"></circle>

        <rect class="meter-box" x="1241" y="220" width="32" height="49"></rect>
        <rect class="meter-box" x="1241" y="286" width="32" height="49"></rect>
        <rect class="meter-box" x="1241" y="352" width="32" height="49"></rect>
        <text class="meter-text meter-text--compact" x="1257" y="258">Wh</text>
        <text class="meter-text meter-text--compact" x="1257" y="324">Wh</text>
        <text class="meter-text meter-text--compact" x="1257" y="390">Wh</text>
        <text class="network-ellipsis" x="1160" y="376">…</text>
        <text class="network-muted" x="1093" y="450">{tr('0,4 кВ', '0.4 kV')}</text>
        <text class="network-block-title" x="1180" y="453">{tr('Нагрузка', 'Load')}</text>
      </g>

      <g
        class="physical-node physical-node--context"
        data-detail-id="external"
        data-node-id="external"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание внешних условий и технологического процесса', 'Open external-condition and production-process details')}
      >
        <rect class="physical-hit" x="1308" y="150" width="304" height="318" rx="20"></rect>
        <text class="physical-context-copy" x="1326" y="187">
          <tspan x="1326" dy="0">{tr('• Технологический процесс', '• Production process')}</tspan>
          <tspan x="1326" dy="30">{tr('  производства', '  requirements')}</tspan>
        </text>
        <text class="physical-context-copy" x="1326" y="278">
          <tspan x="1326" dy="0">{tr('• Погодные условия /', '• Weather and external')}</tspan>
          <tspan x="1326" dy="30">{tr('  внешние условия,', '  conditions affecting')}</tspan>
          <tspan x="1326" dy="30">{tr('  влияющие на', '  the production')}</tspan>
          <tspan x="1326" dy="30">{tr('  техпроцесс', '  process')}</tspan>
        </text>
        <text class="physical-context-copy" x="1326" y="423">
          <tspan x="1326" dy="0">{tr('• Графики технического', '• Maintenance and repair')}</tspan>
          <tspan x="1326" dy="30">{tr('  обслуживания и ремонта', '  schedules')}</tspan>
        </text>
      </g>
    </g>

    <g class="telemetry-bus" aria-hidden="true">
      <rect x="100" y="792" width="1480" height="76" rx="38"></rect>
      <text class="bus-title" x="840" y="825">{tr('ПОТОКИ ДАННЫХ', 'DATA FLOWS')}</text>
      <text class="bus-copy" x="840" y="852">{tr('телеметрия · технологические параметры · контекст режима', 'telemetry · process parameters · operating context')}</text>
      <path class="data-drop" d="M300 868v104" marker-end="url(#system-arrow-blue)"></path>
      <path class="data-drop" d="M840 868v90" marker-end="url(#system-arrow-blue)"></path>
      <path class="data-drop" d="M1390 868v104" marker-end="url(#system-arrow-blue)"></path>
    </g>

    <g class="system-level system-level--data-center">
      <rect class="level-frame level-frame--data-center" x="40" y="910" width="1600" height="1510" rx="42"></rect>
      <g
        class="system-hotspot data-center-title"
        data-detail-id="data-center"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание центра обработки данных', 'Open data-centre details')}
      >
        <rect class="level-title-backdrop" x="620" y="881" width="440" height="62" rx="31"></rect>
        <text class="level-title" x="840" y="922">{tr('Центр обработки данных', 'Data Centre')}</text>
      </g>

      <g
        class="system-module module-monitoring"
        data-detail-id="monitoring"
        data-node-id="monitoring"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание блока мониторинга классов нагрузок', 'Open load-class monitoring details')}
      >
        <rect class="module-card" x="120" y="1010" width="360" height="280" rx="28"></rect>
        <circle class="module-index" cx="164" cy="1054" r="22"></circle>
        <text class="module-index-text" x="164" y="1062">01</text>
        <text class="module-kicker" x="202" y="1060">{tr('НАБЛЮДЕНИЕ', 'MONITORING')}</text>
        <text class="module-title" x="150" y="1117">
          <tspan x="150" dy="0">{tr('Мониторинг классов', 'Load-class')}</tspan>
          <tspan x="150" dy="36">{tr('нагрузок', 'monitoring')}</tspan>
        </text>
        <text class="module-copy" x="150" y="1202">
          <tspan x="150" dy="0">{tr('Классификация состояний', 'State classification')}</tspan>
          <tspan x="150" dy="28">{tr('и вероятность включения', 'and ON probability')}</tspan>
        </text>
        <text class="module-action" x="150" y="1260">{tr('Подробнее →', 'Details →')}</text>
      </g>

      <g
        class="system-module module-database"
        data-detail-id="load-data"
        data-node-id="load-data"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание единой базы данных', 'Open unified database details')}
      >
        <rect class="module-card module-card--primary" x="580" y="990" width="520" height="320" rx="28"></rect>
        <circle class="database-icon" cx="628" cy="1041" r="25"></circle>
        <ellipse class="database-icon-line" cx="628" cy="1032" rx="12" ry="5"></ellipse>
        <path class="database-icon-line" d="M616 1032v18c0 6 24 6 24 0v-18m-24 9c0 6 24 6 24 0"></path>
        <text class="module-kicker" x="668" y="1048">{tr('ЕДИНАЯ БАЗА ДАННЫХ', 'UNIFIED DATABASE')}</text>
        <line class="table-line" x1="616" y1="1104" x2="1062" y2="1104"></line>
        <line class="table-line" x1="616" y1="1161" x2="1062" y2="1161"></line>
        <line class="table-line" x1="872" y1="1073" x2="872" y2="1192"></line>
        <text class="table-head" x="616" y="1095">Time stamp</text>
        <text class="table-head" x="906" y="1095">Data</text>
        <text class="table-value" x="616" y="1144">2026-01-01 23:10:59</text>
        <text class="table-value" x="906" y="1144">{tr('72,23', '72.23')}</text>
        <text class="module-copy" x="616" y="1222">
          <tspan x="616" dy="0">{tr('Электротехнические, технологические', 'Electrical, process, and')}</tspan>
          <tspan x="616" dy="28">{tr('и внешние параметры', 'external parameters')}</tspan>
        </text>
        <text class="module-action" x="616" y="1282">{tr('Подробнее →', 'Details →')}</text>
      </g>

      <g
        class="system-module module-forecast"
        data-detail-id="forecast"
        data-node-id="forecast"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание блока прогноза временных рядов', 'Open time-series forecasting details')}
      >
        <rect class="module-card" x="1220" y="1010" width="340" height="280" rx="28"></rect>
        <circle class="module-index module-index--coral" cx="1264" cy="1054" r="22"></circle>
        <text class="module-index-text" x="1264" y="1062">02</text>
        <text class="module-kicker module-kicker--coral" x="1302" y="1060">{tr('ПРОГНОЗ', 'FORECAST')}</text>
        <text class="module-title" x="1250" y="1117">
          <tspan x="1250" dy="0">{tr('Прогноз временных', 'Time-series')}</tspan>
          <tspan x="1250" dy="36">{tr('рядов', 'forecasting')}</tspan>
        </text>
        <text class="metric-value" x="1250" y="1211">{tr('24 часа', '24 hours')}</text>
        <text class="metric-label" x="1250" y="1240">{tr('дискретность · 1 минута', 'resolution · 1 minute')}</text>
        <text class="module-action" x="1250" y="1268">{tr('Подробнее →', 'Details →')}</text>
      </g>

      <g
        class="system-module module-optimization"
        data-detail-id="optimization"
        data-node-id="optimization"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание расчёта параметров DSM методом CC-PSO', 'Open CC-PSO DSM parameter optimisation details')}
      >
        <rect class="module-card module-card--coral" x="120" y="1510" width="400" height="330" rx="28"></rect>
        <circle class="module-index module-index--coral" cx="164" cy="1554" r="22"></circle>
        <text class="module-index-text" x="164" y="1562">03</text>
        <text class="module-kicker module-kicker--coral" x="202" y="1560">{tr('ОПТИМИЗАЦИЯ', 'OPTIMISATION')}</text>
        <text class="module-title" x="150" y="1618">
          <tspan x="150" dy="0">{tr('Параметры DSM', 'DSM parameters')}</tspan>
          <tspan x="150" dy="36">{tr('методом CC-PSO', 'using CC-PSO')}</tspan>
        </text>
        <text class="module-copy" x="150" y="1702">
          <tspan x="150" dy="0">{tr('Настройка DSM и формирование', 'DSM tuning and generation')}</tspan>
          <tspan x="150" dy="28">{tr('сигналов управления нагрузкой', 'of load-control signals')}</tspan>
        </text>
        <rect class="status-chip status-chip--coral" x="150" y="1760" width="244" height="42" rx="21"></rect>
        <text class="status-chip-text status-chip-text--coral" x="272" y="1787">{tr('Итерационный процесс · 6 этапов', 'Iterative process · 6 stages')}</text>
        <text class="module-action" x="150" y="1822">{tr('Подробнее →', 'Details →')}</text>
      </g>

      <g
        class="system-module module-modeling"
        data-detail-id="modeling"
        data-node-id="modeling"
        tabindex="0"
        role="button"
        aria-label={tr('Открыть описание блока моделирования электротехнического комплекса', 'Open power-system modelling details')}
      >
        <rect class="module-card" x="650" y="1535" width="380" height="280" rx="28"></rect>
        <circle class="module-index" cx="694" cy="1579" r="22"></circle>
        <text class="module-index-text" x="694" y="1587">04</text>
        <text class="module-kicker" x="732" y="1585">{tr('РАСЧЁТ РЕЖИМА', 'SYSTEM CALCULATION')}</text>
        <text class="module-title" x="680" y="1643">
          <tspan x="680" dy="0">{tr('Моделирование', 'Isolated power-system')}</tspan>
          <tspan x="680" dy="36">{tr('автономного ЭТК', 'modelling')}</tspan>
        </text>
        <text class="module-copy" x="680" y="1725">MOST · MPC · transmat · xgd · sd</text>
        <text class="module-action" x="680" y="1780">{tr('Подробнее →', 'Details →')}</text>
      </g>

      <g
        class="system-module module-decomposition"
        data-detail-id="decomposition"
        data-node-id="decomposition"
        tabindex="0"
        role="button"
