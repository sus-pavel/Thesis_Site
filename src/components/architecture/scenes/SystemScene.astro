<div class="diagram-surface system-surface is-active" data-scene-surface="system" aria-label="Общая архитектура системы DSM">
  <svg class="connection-map" viewBox="0 0 1500 900" aria-hidden="true">
    <defs>
      <marker id="system-arrow-blue" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#63aef8"></path>
      </marker>
      <marker id="system-arrow-coral" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#ff7558"></path>
      </marker>
    </defs>

    <g class="route route--blue">
      <path d="M295 357 C310 357 310 472 320 472" marker-end="url(#system-arrow-blue)"></path>
      <path d="M412 540 C412 568 405 607 390 607" marker-end="url(#system-arrow-blue)"></path>
      <path d="M390 607 C520 607 535 500 655 500" marker-end="url(#system-arrow-blue)"></path>
    </g>

    <g class="route route--coral">
      <path d="M845 410 C880 410 875 357 905 357" marker-end="url(#system-arrow-coral)"></path>
      <path d="M1090 357 C1110 357 1110 472 1120 472" marker-end="url(#system-arrow-coral)"></path>
      <path d="M1305 472 C1360 472 1360 607 1190 607" marker-end="url(#system-arrow-coral)"></path>
      <path d="M1005 607 C930 607 930 500 845 500" marker-end="url(#system-arrow-coral)"></path>
    </g>

    <g class="route route--neutral">
      <path d="M750 225 L750 355" marker-end="url(#system-arrow-blue)"></path>
      <path d="M750 555 L750 650" marker-end="url(#system-arrow-blue)"></path>
    </g>
  </svg>

  <div class="diagram-zone diagram-zone--blue">
    <span class="zone-title">01 · Аудит потенциала</span>
  </div>

  <div class="diagram-zone diagram-zone--coral">
    <span class="zone-title">02 · Адресное управление</span>
  </div>

  <article class="diagram-node system-node node-monitoring" data-node-id="monitoring">
    <button class="node-main" type="button" data-detail-id="monitoring">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M5 21V14m6 7V8m6 13v-9m6 9V5"></path></svg>
      </span>
      <strong>Мониторинг<br />классов нагрузок</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-data">
    <button class="node-main" type="button" data-detail-id="load-data">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><ellipse cx="14" cy="7" rx="8" ry="3.5"></ellipse><path d="M6 7v7c0 2 3.6 3.5 8 3.5s8-1.5 8-3.5V7m-16 7v7c0 2 3.6 3.5 8 3.5s8-1.5 8-3.5v-7"></path></svg>
      </span>
      <strong>Данные ЭЭ<br />и техпроцесса</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-model">
    <button class="node-main" type="button" data-detail-id="modeling">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M4 17c3-8 5 8 8 0s5-8 8 0 4 0 4 0"></path></svg>
      </span>
      <strong>Моделирование<br />ЭТК</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-datacenter is-selected">
    <button class="node-main" type="button" data-detail-id="data-center">
      <span class="node-icon node-icon--large" aria-hidden="true">
        <svg viewBox="0 0 32 32"><rect x="6" y="5" width="20" height="6" rx="2"></rect><rect x="6" y="13" width="20" height="6" rx="2"></rect><rect x="6" y="21" width="20" height="6" rx="2"></rect><path d="M10 8h1m-1 8h1m-1 8h1"></path></svg>
      </span>
      <strong>ЦОД</strong>
      <small>Центр обработки данных</small>
    </button>
  </article>

  <article class="diagram-node system-node node-control">
    <button class="node-main" type="button" data-detail-id="control">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M5 8h18M5 14h18M5 20h18M10 5v6m8 0v6m-5 0v6"></path></svg>
      </span>
      <strong>Управление<br />нагрузкой</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-external">
    <button class="node-main" type="button" data-detail-id="external">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M7 19a5 5 0 0 1 2-9.6A7 7 0 0 1 22 12a4 4 0 0 1-1 7H7Z"></path></svg>
      </span>
      <strong>Внешние условия<br />и техпроцесс</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-forecast">
    <button class="node-main" type="button" data-detail-id="forecast">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="M4 22 10 14l4 4 8-12m-4 0h4v4"></path></svg>
      </span>
      <strong>Прогноз<br />временных рядов</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-decomposition">
    <button class="node-main" type="button" data-detail-id="decomposition">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><rect x="5" y="5" width="18" height="18" rx="2"></rect><path d="M5 11h18M11 5v18m6-18v18"></path></svg>
      </span>
      <strong>Сингулярное<br />разложение</strong>
    </button>
  </article>

  <article class="diagram-node system-node node-optimization">
    <button class="node-main" type="button" data-detail-id="optimization">
      <span class="node-icon" aria-hidden="true">
        <svg viewBox="0 0 28 28"><path d="m15 3-8 13h6l-1 9 9-14h-6Z"></path></svg>
      </span>
      <strong>Оптимизация<br />CC-PSO</strong>
    </button>
  </article>
</div>
